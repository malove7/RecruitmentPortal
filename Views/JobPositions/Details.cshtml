@model RecruitmentPortal.Models.JobPosition

@{
    ViewData["Title"] = "Job Position Details";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="page-title mb-0">Job Position Details</h1>
                <p class="text-muted mb-0">View full position details.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> Back to List
            </a>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-body p-4">
                <div class="d-flex align-items-center mb-4 pb-4 border-bottom">
                    <div class="avatar bg-soft-success text-success rounded-circle me-3 display-5 fw-bold" style="width: 64px; height: 64px; display: flex; align-items: center; justify-content: center;">
                        <i class="fas fa-briefcase"></i>
                    </div>
                    <div>
                        <h4 class="mb-1">@Model.Title</h4>
                        <div class="text-muted">Created: @Model.CreatedDate.ToString("MMM dd, yyyy")</div>
                    </div>
                    <div class="ms-auto">
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success fs-6 px-3 py-2 rounded-pill">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary fs-6 px-3 py-2 rounded-pill">Inactive</span>
                        }
                    </div>
                </div>

                <div class="row g-4">
                    <div class="col-12">
                        <label class="text-muted text-uppercase small fw-bold mb-2">Description</label>
                        <p class="mb-0 bg-light p-3 rounded">@Model.Description</p>
                    </div>
                    <div class="col-12">
                        <label class="text-muted text-uppercase small fw-bold mb-2">Requirements</label>
                        <p class="mb-0 bg-light p-3 rounded" style="white-space: pre-line;">@Model.Requirements</p>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-light p-3 d-flex justify-content-end">
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary px-4">
                    <i class="fas fa-edit me-1"></i> Edit Position
                </a>
            </div>
        </div>
    </div>
</div>
