@model RecruitmentPortal.Models.JobPosition

@{
    ViewData["Title"] = "Add Job Position";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="page-title mb-0">Add Job Position</h1>
                <p class="text-muted mb-0">Define a new role for recruitment.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> Back to List
            </a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    
                    <h5 class="mb-4 text-primary">Position Details</h5>
                    <div class="row g-3 mb-4">
                        <div class="col-12">
                            <label asp-for="Title" class="form-label">Job Title</label>
                            <input asp-for="Title" class="form-control" placeholder="e.g. Senior Software Engineer" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Describe the role responsibilities..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Requirements" class="form-label">Requirements</label>
                            <textarea asp-for="Requirements" class="form-control" rows="4" placeholder="List skills and qualifications..."></textarea>
                            <span asp-validation-for="Requirements" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="form-check form-switch mb-4">
                        <input class="form-check-input" type="checkbox" asp-for="IsActive" id="flexSwitchCheckChecked" checked>
                        <label class="form-check-label" for="flexSwitchCheckChecked">Active Position</label>
                        <div class="form-text">Active positions are visible to candidates.</div>
                    </div>
                    
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-action="Index" class="btn btn-light me-md-2">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">Create Position</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
