@model IEnumerable<RecruitmentPortal.Models.JobPosition>

@{
    ViewData["Title"] = "Manage Job Positions";
}

<div class="d-flex justify-content-between align-items-center mb-4 dashboard-header">
    <div>
        <h1 class="page-title">Job Positions</h1>
        <p class="page-subtitle">Define and manage open roles.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i> Add Position
    </a>
</div>

<div class="card shadow mb-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="border-top-0 text-muted small text-uppercase ps-4">Title</th>
                        <th class="border-top-0 text-muted small text-uppercase">Description</th>
                        <th class="border-top-0 text-muted small text-uppercase">Requirements</th>
                        <th class="border-top-0 text-muted small text-uppercase">Posted Date</th>
                        <th class="border-top-0 text-muted small text-uppercase">Status</th>
                        <th class="border-top-0 text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
            @foreach (var item in Model) {
                    <tr>
                        <td class="ps-4 fw-medium">
                            @Html.DisplayFor(modelItem => item.Title)
                        </td>
                        <td class="text-truncate" style="max-width: 200px;" title="@item.Description">
                            @Html.DisplayFor(modelItem => item.Description)
                        </td>
                        <td class="text-truncate" style="max-width: 150px;">
                            @Html.DisplayFor(modelItem => item.Requirements)
                        </td>
                        <td>
                            @item.CreatedDate.ToString("MMM dd, yyyy")
                        </td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge badge-success">Active</span>
                            }
                            else
                            {
                                <span class="badge badge-secondary">Closed</span>
                            }
                        </td>
                        <td class="text-end pe-4">
                            <div class="btn-group">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary border-0 text-muted"><i class="fas fa-edit"></i></a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary border-0 text-muted"><i class="fas fa-eye"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger border-0"><i class="fas fa-trash"></i></a>
                            </div>
                        </td>
                    </tr>
            }
                </tbody>
            </table>
        </div>
    </div>
</div>
