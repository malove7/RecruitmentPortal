@{
    Layout = null;
    ViewData["Title"] = "Space Stem | AI HR and Recruitment Portal";
}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <meta
      name="description"
      content="An intelligent 3D command center for Space Stem's AI HR and recruitment portal."
    />

    <!-- Favicon -->
    <link rel="shortcut icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png" asp-append-version="true" />
    <link rel="manifest" href="~/site.webmanifest" />

    <!-- Google Fonts & Font Awesome -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Preload & Styles -->
    <link rel="preload" href="~/assets/spacestem-logo.png" as="image" />
    <link rel="stylesheet" href="~/css/homepage.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/styles.css" asp-append-version="true" />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header" aria-label="Primary navigation">
        <a class="brand" href="#home" aria-label="Space Stem home">
          <img src="~/assets/spacestem-logo.png" alt="Space Stem" />
        </a>
        <nav class="main-nav" aria-label="Main menu">
          <a href="#workflow">Workflow</a>
          <a href="#features">AI Features</a>
          <a href="#demo">Demo</a>
          @if (User.Identity?.IsAuthenticated == true)
          {
            <a asp-controller="Home" asp-action="Dashboard">Dashboard</a>
          }
        </nav>

        @if (User.Identity?.IsAuthenticated == true)
        {
          <div class="header-user-actions">
            <span class="user-greeting">Hi, @(User.FindFirst("FirstName")?.Value ?? User.Identity.Name)</span>
            <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline m-0">
              <button type="submit" class="header-logout-btn" title="Logout">
                <i class="fas fa-sign-out-alt"></i>
              </button>
            </form>
          </div>
        }
        else
        {
          <a class="header-cta" href="/Auth/Login" id="headerLoginBtn">Login</a>
        }
      </header>

      <main>
        <section class="hero" id="home">
          <canvas id="hero-3d" aria-label="Animated AI recruitment command center"></canvas>
          <div class="scene-fallback" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </div>

          <div class="hero-content">
            <p class="eyebrow">AI HR and recruitment portal</p>
            <h1>Hire with intelligence that already understands your company.</h1>
            <p class="hero-copy">
              Space Stem turns resumes, role requirements, company knowledge, and interview data
              into one guided recruitment workspace for faster, better-matched hiring.
            </p>
            <div class="hero-actions" aria-label="Homepage actions">
              <a class="primary-action" href="#workflow">Explore workflow</a>
              <a class="secondary-action" href="#features">View AI features</a>
              @if (User.Identity?.IsAuthenticated != true)
              {
                <button type="button" class="portal-action" id="heroPortalLoginBtn">
                  <i class="fas fa-arrow-right-to-bracket me-2"></i> Portal Login
                </button>
              }
            </div>
            <dl class="proof-strip">
              <div>
                <dt>85%</dt>
                <dd>less manual screening</dd>
              </div>
              <div>
                <dt>4x</dt>
                <dd>faster shortlist creation</dd>
              </div>
              <div>
                <dt>24/7</dt>
                <dd>company-aware assistant</dd>
              </div>
            </dl>
          </div>

          <div class="feature-layer" id="features" aria-label="AI recruitment features">
            <article class="feature-chip chip-resume">
              <span class="chip-mark mark-blue" aria-hidden="true"></span>
              <h2>AI resume scanning</h2>
              <p>Extracts skills, experience, gaps, and fit signals from every applicant profile.</p>
            </article>
            <article class="feature-chip chip-knowledge">
              <span class="chip-mark mark-green" aria-hidden="true"></span>
              <h2>Company knowledgebase</h2>
              <p>Answers hiring questions from policies, role briefs, benefits, and team context.</p>
            </article>
            <article class="feature-chip chip-match">
              <span class="chip-mark mark-orange" aria-hidden="true"></span>
              <h2>Smart talent matching</h2>
              <p>Ranks candidates against role outcomes, culture needs, and must-have skills.</p>
            </article>
            <article class="feature-chip chip-interview">
              <span class="chip-mark mark-coral" aria-hidden="true"></span>
              <h2>Interview automation</h2>
              <p>Creates scorecards, schedules rounds, and keeps hiring teams aligned.</p>
            </article>
          </div>
        </section>

        <section class="workflow-band" id="workflow" aria-label="Recruitment workflow">
          <div class="workflow-inner">
            <p class="section-kicker">Connected hiring flow</p>
            <h2>From intake to final shortlist, the portal keeps the signal moving.</h2>
            <div class="workflow-steps">
              <article>
                <span>01</span>
                <h3>Upload role and resumes</h3>
                <p>Collect candidate files, job descriptions, and team requirements in one place.</p>
              </article>
              <article>
                <span>02</span>
                <h3>Let AI score fit</h3>
                <p>Surface ranked candidates with evidence-backed notes for each decision.</p>
              </article>
              <article>
                <span>03</span>
                <h3>Ask company context</h3>
                <p>Use the knowledgebase to answer role, policy, and process questions instantly.</p>
              </article>
            </div>
          </div>
        </section>

        <section class="demo-band" id="demo" aria-label="Demo request">
          <div>
            <p class="section-kicker">Ready to streamline your recruitment?</p>
            <h2>Designed as a drop-in hero for the Space Stem recruitment portal.</h2>
          </div>
          @if (User.Identity?.IsAuthenticated != true)
          {
            <a class="header-cta compact" href="/Auth/Login" id="demoLoginBtn">Login to Portal</a>
          }
        </section>
      </main>
    </div>

    @if (User.Identity?.IsAuthenticated != true)
    {
      <!-- Interactive Login Modal -->
      <div id="loginModal" class="login-modal-overlay" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
        <div class="login-modal-backdrop" id="modalBackdrop"></div>
        <div class="login-modal-dialog">
          <button type="button" class="login-modal-close" id="closeLoginModal" aria-label="Close modal">&times;</button>
          
          <div class="login-modal-header">
            <img src="~/assets/spacestem-logo.png" alt="Space Stem" class="modal-logo" />
            <h3 id="modalTitle">Welcome Back</h3>
            <p>Enter your credentials to access the recruitment workspace</p>
          </div>

          <div id="loginModalAlert" class="modal-alert" style="display: none;" role="alert">
            <i class="fas fa-exclamation-circle"></i>
            <span id="loginAlertText"></span>
          </div>

          <form id="modalLoginForm" method="post" action="/Auth/Login">
            @Html.AntiForgeryToken()
            <div class="modal-form-group">
              <label for="modalEmail">Email Address</label>
              <div class="input-with-icon">
                <input
                  type="email"
                  id="modalEmail"
                  name="email"
                  class="modal-input"
                  placeholder="admin@recruitmentportal.com"
                  required
                  autocomplete="username"
                />
                <i class="fas fa-envelope input-icon"></i>
              </div>
            </div>

            <div class="modal-form-group">
              <label for="modalPassword">Password</label>
              <div class="input-with-icon">
                <input
                  type="password"
                  id="modalPassword"
                  name="password"
                  class="modal-input"
                  placeholder="••••••••"
                  required
                  autocomplete="current-password"
                />
                <button type="button" class="pwd-toggle" id="togglePasswordBtn" aria-label="Toggle password visibility">
                  <i class="fas fa-eye" id="pwdToggleIcon"></i>
                </button>
              </div>
            </div>

            <div class="modal-options">
              <label class="remember-checkbox">
                <input type="checkbox" id="modalRememberMe" name="rememberMe" value="true" />
                <span>Remember me</span>
              </label>
              <a href="/Auth/ForgotPassword" class="forgot-link">Forgot password?</a>
            </div>

            <button type="submit" class="modal-submit-btn" id="modalSubmitBtn">
              <span id="modalSubmitText">Sign In to Portal</span>
              <span id="modalSubmitSpinner" style="display: none;">
                <i class="fas fa-circle-notch fa-spin"></i> Authenticating...
              </span>
            </button>
          </form>

          <div class="modal-footer">
            <a href="/Auth/Login" class="full-login-link">
              Need full-screen view? Open dedicated login page <i class="fas fa-arrow-right ms-1"></i>
            </a>
          </div>
        </div>
      </div>
    }

    <!-- 3D Animation Scripts -->
    <script src="~/vendor/three.min.js"></script>
    <script src="~/js/homepage-3d.js"></script>

    @if (User.Identity?.IsAuthenticated != true)
    {
      <script>
        (() => {
          const loginModal = document.getElementById('loginModal');
          const closeBtn = document.getElementById('closeLoginModal');
          const backdrop = document.getElementById('modalBackdrop');
          const modalDialog = loginModal?.querySelector('.login-modal-dialog');
          const emailInput = document.getElementById('modalEmail');
          const pwdInput = document.getElementById('modalPassword');
          const pwdToggleBtn = document.getElementById('togglePasswordBtn');
          const pwdToggleIcon = document.getElementById('pwdToggleIcon');
          const loginForm = document.getElementById('modalLoginForm');
          const alertBox = document.getElementById('loginModalAlert');
          const alertText = document.getElementById('loginAlertText');
          const submitBtn = document.getElementById('modalSubmitBtn');
          const submitText = document.getElementById('modalSubmitText');
          const submitSpinner = document.getElementById('modalSubmitSpinner');

          // Trigger buttons
          const triggerBtns = [
            document.getElementById('headerLoginBtn'),
            document.getElementById('heroPortalLoginBtn'),
            document.getElementById('demoLoginBtn')
          ].filter(Boolean);

          const openModal = (e) => {
            if (e) e.preventDefault();
            if (!loginModal) return;
            loginModal.classList.add('is-open');
            loginModal.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
            setTimeout(() => emailInput?.focus(), 150);
          };

          const closeModal = () => {
            if (!loginModal) return;
            loginModal.classList.remove('is-open');
            loginModal.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
            hideAlert();
          };

          const showAlert = (message) => {
            if (!alertBox || !alertText) return;
            alertText.textContent = message;
            alertBox.style.display = 'flex';
            if (modalDialog) {
              modalDialog.classList.remove('shake');
              void modalDialog.offsetWidth; // Trigger reflow
              modalDialog.classList.add('shake');
            }
          };

          const hideAlert = () => {
            if (!alertBox) return;
            alertBox.style.display = 'none';
          };

          triggerBtns.forEach((btn) => btn.addEventListener('click', openModal));

          closeBtn?.addEventListener('click', closeModal);
          backdrop?.addEventListener('click', closeModal);

          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && loginModal?.classList.contains('is-open')) {
              closeModal();
            }
          });

          // Password Visibility Toggle
          pwdToggleBtn?.addEventListener('click', () => {
            if (!pwdInput || !pwdToggleIcon) return;
            const isPassword = pwdInput.type === 'password';
            pwdInput.type = isPassword ? 'text' : 'password';
            pwdToggleIcon.classList.toggle('fa-eye', !isPassword);
            pwdToggleIcon.classList.toggle('fa-eye-slash', isPassword);
          });

          // AJAX Login Handler
          loginForm?.addEventListener('submit', async (e) => {
            e.preventDefault();
            hideAlert();

            const email = emailInput?.value.trim() || '';
            const password = pwdInput?.value || '';
            const rememberMe = document.getElementById('modalRememberMe')?.checked || false;
            const token = loginForm.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            if (!email || !password) {
              showAlert('Please enter both email and password.');
              return;
            }

            // Set loading state
            if (submitBtn && submitText && submitSpinner) {
              submitBtn.disabled = true;
              submitText.style.display = 'none';
              submitSpinner.style.display = 'inline-block';
            }

            try {
              const formData = new FormData();
              formData.append('email', email);
              formData.append('password', password);
              formData.append('rememberMe', rememberMe);
              if (token) {
                formData.append('__RequestVerificationToken', token);
              }

              const response = await fetch('/Auth/Login', {
                method: 'POST',
                headers: {
                  'Accept': 'application/json',
                  'X-Requested-With': 'XMLHttpRequest'
                },
                body: formData
              });

              if (response.ok) {
                const data = await response.json();
                if (data.success) {
                  submitSpinner.innerHTML = '<i class="fas fa-check"></i> Redirecting...';
                  window.location.href = data.redirectUrl || '/Home/Dashboard';
                  return;
                } else {
                  showAlert(data.message || 'Invalid login attempt. Please check your credentials.');
                }
              } else {
                showAlert('Login failed. Please check your email and password.');
              }
            } catch (err) {
              // Network error or unexpected response — fall back to standard form submission
              console.warn('AJAX login failed, submitting form normally:', err);
              loginForm.submit();
              return;
            } finally {
              if (submitBtn && submitText && submitSpinner && submitSpinner.innerText.indexOf('Redirecting') === -1) {
                submitBtn.disabled = false;
                submitText.style.display = 'inline-block';
                submitSpinner.style.display = 'none';
              }
            }
          });
        })();
      </script>
    }
  </body>
</html>
