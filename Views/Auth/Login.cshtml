@{
    Layout = null;
    ViewData["Title"] = "Login";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In - Space Stem Recruitment Portal</title>
    
    <!-- Favicon -->
    <link rel="shortcut icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- FontAwesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Theme & Auth Styles -->
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>

    <div class="auth-split-wrapper">
        
        <!-- Left Side: Branded Identity & Features Showcase -->
        <aside class="auth-showcase-panel" aria-label="Brand Overview">
            <div class="showcase-header">
                <a asp-controller="Home" asp-action="Index" class="showcase-brand-link" title="Space Stem Home">
                    <span class="showcase-brand-text">SPACE <span class="brand-highlight">STEM</span></span>
                </a>
            </div>

            <div class="showcase-main-content">
                <div class="showcase-eyebrow">
                    <i class="fas fa-sparkles"></i> AI Recruitment Platform
                </div>
                <h1 class="showcase-headline">
                    Empowering modern recruitment teams.
                </h1>
                <p class="showcase-lead">
                    One unified command center to source talent, evaluate candidates collaboratively, and accelerate hiring decisions.
                </p>

                <div class="showcase-features-list">
                    <div class="showcase-feature-item">
                        <div class="showcase-feature-icon">
                            <i class="fas fa-file-lines"></i>
                        </div>
                        <div class="showcase-feature-text">
                            <div class="showcase-feature-title">Smart Resume Screening</div>
                            <div class="showcase-feature-desc">Automated CV parsing, qualification matching, and candidate ranking.</div>
                        </div>
                    </div>

                    <div class="showcase-feature-item">
                        <div class="showcase-feature-icon">
                            <i class="fas fa-clipboard-check"></i>
                        </div>
                        <div class="showcase-feature-text">
                            <div class="showcase-feature-title">Structured Evaluations</div>
                            <div class="showcase-feature-desc">Objective scorecards, salary expectations, and multi-round interviewer feedback.</div>
                        </div>
                    </div>

                    <div class="showcase-feature-item">
                        <div class="showcase-feature-icon">
                            <i class="fas fa-shield-halved"></i>
                        </div>
                        <div class="showcase-feature-text">
                            <div class="showcase-feature-title">Role-Based Security</div>
                            <div class="showcase-feature-desc">Strict JWT authentication and fine-grained permissions for Admins, HR, and Interviewers.</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="showcase-footer">
                <span>Space Stem Portal &bull; Enterprise</span>
                <span class="showcase-status">
                    <span class="status-dot-live"></span> All systems operational
                </span>
            </div>
        </aside>

        <!-- Right Side: Login Form Area -->
        <main class="auth-form-panel">
            <div class="auth-form-container">
                
                <div class="auth-top-nav">
                    <a asp-controller="Home" asp-action="Index" class="auth-back-link">
                        <i class="fas fa-arrow-left"></i> Back to Homepage
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="text-decoration-none">
                        <span class="mobile-brand-text">SPACE <span class="brand-highlight">STEM</span></span>
                    </a>
                </div>
                
                <div class="auth-heading-wrap">
                    <h1 class="auth-title">Sign in to your account</h1>
                    <p class="auth-subtitle">
                        Welcome back. Enter your staff credentials to access your recruitment pipeline.
                    </p>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="auth-alert-box" role="alert">
                        <i class="fas fa-circle-exclamation"></i>
                        <div class="auth-alert-text">
                            <div asp-validation-summary="ModelOnly" class="m-0 p-0 list-unstyled"></div>
                        </div>
                    </div>
                }

                <form asp-action="Login" method="post" id="loginPageForm" novalidate>
                    @if (ViewData["ReturnUrl"] != null)
                    {
                        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                    }

                    <div class="auth-field-group">
                        <label for="email" class="auth-label">Work Email address</label>
                        <div class="auth-input-wrapper">
                            <i class="fas fa-envelope auth-input-icon" aria-hidden="true"></i>
                            <input
                                type="email"
                                id="email"
                                name="email"
                                class="auth-input"
                                placeholder="name@spacestem.com"
                                required
                                autocomplete="email"
                                autofocus
                            />
                        </div>
                    </div>

                    <div class="auth-field-group">
                        <div class="auth-field-label-row">
                            <label for="password" class="auth-label">Password</label>
                            <a asp-action="ForgotPassword" class="auth-forgot-link">Forgot password?</a>
                        </div>
                        <div class="auth-input-wrapper">
                            <i class="fas fa-lock auth-input-icon" aria-hidden="true"></i>
                            <input
                                type="password"
                                id="password"
                                name="password"
                                class="auth-input has-toggle"
                                placeholder="Enter your password"
                                required
                                autocomplete="current-password"
                            />
                            <button
                                type="button"
                                class="password-toggle-btn"
                                id="togglePasswordBtn"
                                aria-label="Toggle password visibility"
                                tabindex="-1"
                            >
                                <i class="fas fa-eye" id="togglePasswordIcon" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>

                    <div class="auth-options-row">
                        <label class="auth-checkbox-label" for="rememberMe">
                            <input
                                type="checkbox"
                                id="rememberMe"
                                name="rememberMe"
                                value="true"
                            />
                            <span>Remember me on this device</span>
                        </label>
                    </div>

                    <button type="submit" class="auth-submit-btn" id="submitLoginBtn">
                        <span id="submitBtnText">
                            Sign In to Portal <i class="fas fa-arrow-right ms-1" aria-hidden="true"></i>
                        </span>
                        <span id="submitBtnSpinner" style="display: none;">
                            <i class="fas fa-circle-notch fa-spin me-2" aria-hidden="true"></i> Authenticating...
                        </span>
                    </button>
                </form>

                <div class="auth-footer-wrap">
                    <div class="auth-security-badge">
                        <i class="fas fa-shield-halved" aria-hidden="true"></i> Encrypted 256-bit SSL &bull; Role-governed session
                    </div>
                    <p class="auth-copyright">
                        &copy; @DateTime.UtcNow.Year Space Stem. All rights reserved.
                    </p>
                </div>

            </div>
        </main>
        
    </div>

    <script>
        (() => {
            'use strict';

            // Password Toggle
            const toggleBtn = document.getElementById('togglePasswordBtn');
            const pwdInput = document.getElementById('password');
            const toggleIcon = document.getElementById('togglePasswordIcon');

            if (toggleBtn && pwdInput && toggleIcon) {
                toggleBtn.addEventListener('click', (e) => {
                    e.preventDefault();
                    const isPassword = pwdInput.type === 'password';
                    pwdInput.type = isPassword ? 'text' : 'password';
                    toggleIcon.classList.toggle('fa-eye', !isPassword);
                    toggleIcon.classList.toggle('fa-eye-slash', isPassword);
                    pwdInput.focus();
                });
            }

            // Form Submit Loading State
            const form = document.getElementById('loginPageForm');
            const submitBtn = document.getElementById('submitLoginBtn');
            const btnText = document.getElementById('submitBtnText');
            const btnSpinner = document.getElementById('submitBtnSpinner');

            if (form && submitBtn && btnText && btnSpinner) {
                form.addEventListener('submit', (e) => {
                    if (!form.checkValidity()) {
                        return; // Let browser HTML5 validation show
                    }

                    submitBtn.disabled = true;
                    btnText.style.display = 'none';
                    btnSpinner.style.display = 'inline-flex';
                });
            }
        })();
    </script>
</body>
</html>
