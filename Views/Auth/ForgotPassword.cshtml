@{
    Layout = null;
    ViewData["Title"] = "Forgot Password";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password - Space Stem Recruitment Portal</title>
    
    <!-- Favicon -->
    <link rel="shortcut icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- FontAwesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Theme & Auth Styles -->
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>

    <div class="auth-split-wrapper">
        
        <!-- Left Side: Branded Identity -->
        <aside class="auth-showcase-panel" aria-label="Brand Overview">
            <div class="showcase-header">
                <a asp-controller="Home" asp-action="Index" class="showcase-brand-link" title="Space Stem Home">
                    <span class="showcase-brand-text">SPACE <span class="brand-highlight">STEM</span></span>
                </a>
            </div>

            <div class="showcase-main-content">
                <div class="showcase-eyebrow">
                    <i class="fas fa-key"></i> Password Recovery
                </div>
                <h1 class="showcase-headline">
                    Recover your staff portal access.
                </h1>
                <p class="showcase-lead">
                    Enter your verified work email address and we'll send you instructions to securely reset your credentials.
                </p>

                <div class="showcase-features-list">
                    <div class="showcase-feature-item">
                        <div class="showcase-feature-icon">
                            <i class="fas fa-shield-halved"></i>
                        </div>
                        <div class="showcase-feature-text">
                            <div class="showcase-feature-title">Verified Identity Check</div>
                            <div class="showcase-feature-desc">Reset tokens are single-use, time-limited, and sent only to registered emails.</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="showcase-footer">
                <span>Space Stem Portal &bull; Enterprise</span>
                <span class="showcase-status">
                    <span class="status-dot-live"></span> All systems operational
                </span>
            </div>
        </aside>

        <!-- Right Side: Reset Request Form -->
        <main class="auth-form-panel">
            <div class="auth-form-container">
                
                <div class="auth-top-nav">
                    <a asp-action="Login" class="auth-back-link">
                        <i class="fas fa-arrow-left"></i> Back to Sign In
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="text-decoration-none">
                        <span class="mobile-brand-text">SPACE <span class="brand-highlight">STEM</span></span>
                    </a>
                </div>
                
                <div class="auth-heading-wrap">
                    <h1 class="auth-title">Forgot your password?</h1>
                    <p class="auth-subtitle">
                        No worries. Enter your work email below to receive a password reset link.
                    </p>
                </div>

                @if (ViewBag.Message != null)
                {
                    <div class="alert alert-success d-flex align-items-center gap-2 mb-4" role="alert">
                        <i class="fas fa-circle-check"></i>
                        <span>@ViewBag.Message</span>
                    </div>
                }

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="auth-alert-box" role="alert">
                        <i class="fas fa-circle-exclamation"></i>
                        <div class="auth-alert-text">
                            <div asp-validation-summary="ModelOnly" class="m-0 p-0 list-unstyled"></div>
                        </div>
                    </div>
                }

                <form asp-action="ForgotPassword" method="post" id="forgotPasswordForm" novalidate>
                    <div class="auth-field-group mb-4">
                        <label for="email" class="auth-label">Work Email address</label>
                        <div class="auth-input-wrapper">
                            <i class="fas fa-envelope auth-input-icon" aria-hidden="true"></i>
                            <input
                                type="email"
                                id="email"
                                name="email"
                                class="auth-input"
                                placeholder="name@spacestem.com"
                                required
                                autocomplete="email"
                                autofocus
                            />
                        </div>
                    </div>

                    <button type="submit" class="auth-submit-btn" id="submitResetBtn">
                        <span id="submitResetText">
                            Send Reset Instructions <i class="fas fa-paper-plane ms-1" aria-hidden="true"></i>
                        </span>
                        <span id="submitResetSpinner" style="display: none;">
                            <i class="fas fa-circle-notch fa-spin me-2" aria-hidden="true"></i> Sending...
                        </span>
                    </button>

                    <div class="text-center mt-3">
                        <a asp-action="Login" class="auth-forgot-link">
                            Remember your password? Sign in instead
                        </a>
                    </div>
                </form>

                <div class="auth-footer-wrap">
                    <div class="auth-security-badge">
                        <i class="fas fa-shield-halved" aria-hidden="true"></i> Need administrative assistance? Contact IT Support
                    </div>
                    <p class="auth-copyright">
                        &copy; @DateTime.UtcNow.Year Space Stem. All rights reserved.
                    </p>
                </div>

            </div>
        </main>
        
    </div>

    <script>
        (() => {
            'use strict';
            const form = document.getElementById('forgotPasswordForm');
            const submitBtn = document.getElementById('submitResetBtn');
            const btnText = document.getElementById('submitResetText');
            const btnSpinner = document.getElementById('submitResetSpinner');

            if (form && submitBtn && btnText && btnSpinner) {
                form.addEventListener('submit', (e) => {
                    if (!form.checkValidity()) return;
                    submitBtn.disabled = true;
                    btnText.style.display = 'none';
                    btnSpinner.style.display = 'inline-flex';
                });
            }
        })();
    </script>
</body>
</html>
