@model RecruitmentPortal.Models.Candidate

@{
    ViewData["Title"] = "Add Candidate";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="page-title mb-0">Add Candidate</h1>
                <p class="text-muted mb-0">Enter candidate details and upload resume.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> Back to List
            </a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Create" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    
                    <h5 class="mb-4 text-primary">Personal Information</h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label">First Name <span class="text-danger">*</span></label>
                            <input asp-for="FirstName" class="form-control" placeholder="e.g. John" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label">Last Name <span class="text-danger">*</span></label>
                            <input asp-for="LastName" class="form-control" placeholder="e.g. Doe" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label">Email Address <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="fas fa-envelope"></i></span>
                                <input asp-for="Email" class="form-control" placeholder="john.doe@example.com" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label">Phone Number <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="fas fa-phone"></i></span>
                                <input asp-for="Phone" class="form-control" placeholder="(555) 123-4567" />
                            </div>
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                    </div>

                    <h5 class="mb-4 text-primary">Additional Information</h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="DOB" class="form-label">Date of Birth</label>
                            <input asp-for="DOB" type="date" class="form-control" />
                            <span asp-validation-for="DOB" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="HighestEducation" class="form-label">Highest Education</label>
                            <input asp-for="HighestEducation" class="form-control" placeholder="e.g. BCA, MCA, B.Tech" />
                            <span asp-validation-for="HighestEducation" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CurrentLocation" class="form-label">Current Location</label>
                            <input asp-for="CurrentLocation" class="form-control" placeholder="e.g. Gandhinagar, Gujarat" />
                            <span asp-validation-for="CurrentLocation" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="NoticePeriod" class="form-label">Notice Period</label>
                            <input asp-for="NoticePeriod" class="form-control" placeholder="e.g. 30 Days" />
                            <span asp-validation-for="NoticePeriod" class="text-danger small"></span>
                        </div>
                        <div class="col-md-12">
                            <label asp-for="Experience" class="form-label">Experience</label>
                            <input asp-for="Experience" class="form-control" placeholder="e.g. 1.7 Years (.NET / SQL Server / MVC)" />
                            <span asp-validation-for="Experience" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CurrentCTC" class="form-label">Current CTC (Per Month)</label>
                            <input asp-for="CurrentCTC" class="form-control" placeholder="e.g. ₹2,80,000" />
                            <span asp-validation-for="CurrentCTC" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ExpectedCTC" class="form-label">Expected CTC (Per Month)</label>
                            <input asp-for="ExpectedCTC" class="form-control" placeholder="e.g. As per expectation" />
                            <span asp-validation-for="ExpectedCTC" class="text-danger small"></span>
                        </div>
                        <div class="col-md-12">
                            <label asp-for="ReasonForChange" class="form-label">Reason for Job Change</label>
                            <textarea asp-for="ReasonForChange" class="form-control" rows="3" placeholder="e.g. Looking for better growth opportunities"></textarea>
                            <span asp-validation-for="ReasonForChange" class="text-danger small"></span>
                        </div>
                    </div>

                    <h5 class="mb-4 text-primary">Application Details</h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="JobPositionId" class="form-label">Job Position</label>
                            <select asp-for="JobPositionId" class="form-select" asp-items="ViewBag.JobPositionId">
                                <option value="">-- Select Position --</option>
                            </select>
                            <span asp-validation-for="JobPositionId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ResumePath" class="form-label">Resume / CV</label>
                            <input type="file" name="resumeFile" class="form-control" />
                            <div class="form-text">PDF, DOC, or DOCX formats allowed.</div>
                            <span asp-validation-for="ResumePath" class="text-danger small"></span>
                        </div>
                    </div>
                    
                    <h5 class="mb-4 text-primary mt-4">Notes</h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-12">
                            <label asp-for="NewNote" class="form-label">Initial Note</label>
                            <textarea asp-for="NewNote" class="form-control" rows="3" placeholder="Enter an initial note (optional)..."></textarea>
                            <span asp-validation-for="NewNote" class="text-danger small"></span>
                        </div>
                    </div>
                    
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-action="Index" class="btn btn-light me-md-2">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">Create Candidate</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
