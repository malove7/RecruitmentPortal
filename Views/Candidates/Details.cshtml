@model RecruitmentPortal.Models.Candidate

@{
    ViewData["Title"] = "Candidate Details";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="page-title mb-0">Candidate Details</h1>
                <p class="text-muted mb-0">View full candidate profile.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> Back to List
            </a>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-body p-4">
                <div class="d-flex align-items-center mb-4 pb-4 border-bottom">
                    <div class="avatar bg-soft-primary text-primary rounded-circle me-3 display-5 fw-bold" style="width: 64px; height: 64px; display: flex; align-items: center; justify-content: center;">
                        @Model.FirstName.Substring(0,1)@Model.LastName.Substring(0,1)
                    </div>
                    <div>
                        <h4 class="mb-1">@Model.FirstName @Model.LastName</h4>
                        <div class="text-muted"><i class="far fa-envelope me-2"></i>@Model.Email</div>
                    </div>
                    <div class="ms-auto">
                        @{
                            var statusBadge = "bg-secondary";
                            if (Model.Status == RecruitmentPortal.Models.CandidateStatus.Applied) statusBadge = "bg-info";
                            else if (Model.Status == RecruitmentPortal.Models.CandidateStatus.InterviewScheduled) statusBadge = "bg-primary";
                            else if (Model.Status == RecruitmentPortal.Models.CandidateStatus.Rejected) statusBadge = "bg-danger";
                            else if (Model.Status == RecruitmentPortal.Models.CandidateStatus.Hired) statusBadge = "bg-success";
                        }
                        <span class="badge @statusBadge fs-6 px-3 py-2 rounded-pill">@Model.Status</span>
                    </div>
                </div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="text-muted text-uppercase small fw-bold mb-1">Phone</label>
                        <p class="mb-0 fw-medium">@(Model.Phone ?? "N/A")</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted text-uppercase small fw-bold mb-1">Applying For</label>
                        <p class="mb-0 fw-medium">@Model.JobPosition?.Title</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted text-uppercase small fw-bold mb-1">Date of Birth</label>
                        <p class="mb-0 fw-medium">@(Model.DOB?.ToString("MMM dd, yyyy") ?? "N/A")</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted text-uppercase small fw-bold mb-1">Current Location</label>
                        <p class="mb-0 fw-medium">@(string.IsNullOrEmpty(Model.CurrentLocation) ? "N/A" : Model.CurrentLocation)</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted text-uppercase small fw-bold mb-1">Experience</label>
                        <p class="mb-0 fw-medium">@(string.IsNullOrEmpty(Model.Experience) ? "N/A" : Model.Experience)</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted text-uppercase small fw-bold mb-1">Highest Education</label>
                        <p class="mb-0 fw-medium">@(string.IsNullOrEmpty(Model.HighestEducation) ? "N/A" : Model.HighestEducation)</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted text-uppercase small fw-bold mb-1">Notice Period</label>
                        <p class="mb-0 fw-medium">@(string.IsNullOrEmpty(Model.NoticePeriod) ? "N/A" : Model.NoticePeriod)</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted text-uppercase small fw-bold mb-1">Applied Date</label>
                        <p class="mb-0 fw-medium">@Model.AppliedDate.ToString("MMM dd, yyyy")</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted text-uppercase small fw-bold mb-1">Current CTC</label>
                        <p class="mb-0 fw-medium">@(string.IsNullOrEmpty(Model.CurrentCTC) ? "N/A" : Model.CurrentCTC)</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted text-uppercase small fw-bold mb-1">Expected CTC</label>
                        <p class="mb-0 fw-medium">@(string.IsNullOrEmpty(Model.ExpectedCTC) ? "N/A" : Model.ExpectedCTC)</p>
                    </div>
                    <div class="col-12">
                        <label class="text-muted text-uppercase small fw-bold mb-1">Reason for Change</label>
                        <p class="mb-0 fw-medium">@(string.IsNullOrEmpty(Model.ReasonForChange) ? "N/A" : Model.ReasonForChange)</p>
                    </div>
                    <div class="col-12">
                        <label class="text-muted text-uppercase small fw-bold mb-1">Resume</label>
                        <p class="mb-0">
                            @if (!string.IsNullOrEmpty(Model.ResumePath))
                            {
                                <a href="@Model.ResumePath" target="_blank" class="text-primary text-decoration-none">
                                    <i class="fas fa-file-pdf me-1"></i> View Resume
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">No resume uploaded</span>
                            }
                        </p>
                    </div>
                </div>
                
                <h5 class="mt-4 mb-3 pb-2 border-bottom text-primary">Notes Timeline</h5>
                @if (Model.Notes != null && Model.Notes.Any())
                {
                    <div class="timeline mt-3">
                        @foreach (var note in Model.Notes.OrderByDescending(n => n.CreatedAt))
                        {
                            <div class="card mb-3 shadow-sm border-start border-4 border-info">
                                <div class="card-body py-2">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="badge bg-light text-dark border"><i class="far fa-clock me-1"></i>@note.CreatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                                    </div>
                                    <p class="card-text mb-0 fs-6">@note.NoteText</p>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-light text-muted border" role="alert">
                        <i class="fas fa-info-circle me-2"></i> No notes recorded for this candidate.
                    </div>
                }

            </div>
            <div class="card-footer bg-light p-3 d-flex justify-content-end">
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary px-4">
                    <i class="fas fa-edit me-1"></i> Edit Profile
                </a>
            </div>
        </div>
    </div>
</div>
