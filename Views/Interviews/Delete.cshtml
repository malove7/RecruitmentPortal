@model RecruitmentPortal.Models.Interview

@{
    ViewData["Title"] = "Delete Interview";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card shadow-sm border-danger border-top border-3 mt-5">
            <div class="card-body p-5 text-center">
                <div class="mb-4">
                    <i class="fas fa-exclamation-triangle text-danger display-1"></i>
                </div>
                <h2 class="card-title mb-3">Cancel Interview?</h2>
                <p class="card-text text-muted mb-4">
                    Are you sure you want to delete this scheduled interview? This action cannot be undone.
                </p>

                <div class="bg-light p-3 rounded mb-4 text-start">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted small text-uppercase">Time</dt>
                        <dd class="col-sm-8 mb-2">@Model.ScheduledTime.ToString("MMM dd, yyyy hh:mm tt")</dd>
                        
                        <dt class="col-sm-4 text-muted small text-uppercase">Round</dt>
                        <dd class="col-sm-8 mb-2">@Model.Round</dd>
                        
                        <dt class="col-sm-4 text-muted small text-uppercase">Candidate</dt>
                        <dd class="col-sm-8 mb-0">
                            @if(Model.Candidate != null) {
                                <text>@Model.Candidate.FirstName @Model.Candidate.LastName</text>
                            }
                        </dd>
                    </dl>
                </div>
                
                <form asp-action="Delete" class="d-flex justify-content-center gap-3">
                    <input type="hidden" asp-for="Id" />
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Go Back</a>
                    <button type="submit" class="btn btn-danger px-4">Delete Interview</button>
                </form>
            </div>
        </div>
    </div>
</div>
