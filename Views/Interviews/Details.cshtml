@model RecruitmentPortal.Models.Interview

@{
    ViewData["Title"] = "Interview Details";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="page-title mb-0">Interview Details</h1>
                <p class="text-muted mb-0">View scheduled interview information.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> Back to List
            </a>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-body p-4">
                <div class="d-flex align-items-center mb-4 pb-4 border-bottom">
                    <div class="avatar bg-soft-warning text-warning rounded-circle me-3 display-5 fw-bold" style="width: 64px; height: 64px; display: flex; align-items: center; justify-content: center;">
                        <i class="far fa-calendar-alt"></i>
                    </div>
                    <div>
                        <h4 class="mb-1">@Model.Round Round</h4>
                        <div class="text-muted">
                            <i class="far fa-clock me-1"></i> @Model.ScheduledTime.ToString("MMM dd, yyyy hh:mm tt")
                        </div>
                    </div>
                </div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="text-muted text-uppercase small fw-bold mb-1">Candidate</label>
                        <p class="mb-0 fw-medium">
                            @if(Model.Candidate != null) {
                                <text>@Model.Candidate.FirstName @Model.Candidate.LastName</text>
                            } else {
                                <text>N/A</text>
                            }
                        </p>
                        <small class="text-muted">@Model.Candidate?.Email</small>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted text-uppercase small fw-bold mb-1">Interviewer</label>
                         <p class="mb-0 fw-medium">
                             @if(Model.Interviewer != null) {
                                <text>@Model.Interviewer.FirstName @Model.Interviewer.LastName</text>
                             } else {
                                 <text>N/A</text>
                             }
                         </p>
                         <small class="text-muted">@Model.Interviewer?.Email</small>
                    </div>
                     <div class="col-12">
                        <label class="text-muted text-uppercase small fw-bold mb-2">Notes & Instructions</label>
                        <p class="mb-0 bg-light p-3 rounded" style="white-space: pre-line;">@(string.IsNullOrEmpty(Model.Notes) ? "No notes available." : Model.Notes)</p>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-light p-3 d-flex justify-content-end">
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary px-4">
                    <i class="fas fa-edit me-1"></i> Edit Interview
                </a>
            </div>
        </div>
    </div>
</div>
