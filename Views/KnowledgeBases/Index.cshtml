@model RecruitmentPortal.Models.ViewModels.KnowledgeBaseListViewModel

@{
    ViewData["Title"] = "Knowledge Bases";
}

<div class="container-fluid px-4 py-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">Knowledge Bases</h1>
            <p class="text-muted mb-0">Create organizational knowledge bases, upload PDF/DOCX documents, and query them with grounded RAG search.</p>
        </div>
        <div class="d-flex gap-2">
            @if (User.HasClaim("Permission", "AskKnowledgeBases") || User.IsInRole("Admin"))
            {
                <a asp-controller="KnowledgeBaseChat" asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fas fa-comments me-1"></i> Ask Chatbot
                </a>
            }
            @if (User.HasClaim("Permission", "ManageKnowledgeBases") || User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="btn btn-primary">
                    <i class="fas fa-plus me-1"></i> New Knowledge Base
                </a>
            }
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show mb-4" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i> @TempData["WarningMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="fas fa-times-circle me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Stat Tiles -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card shadow-sm border h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="stat-icon-wrapper rounded p-3 me-3" style="background-color: rgba(99, 102, 241, 0.1); color: var(--primary-color);">
                        <i class="fas fa-database fa-2x"></i>
                    </div>
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Knowledge Bases</div>
                        <div class="fs-4 fw-bold text-dark">@Model.TotalKnowledgeBases</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card shadow-sm border h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="stat-icon-wrapper rounded p-3 me-3" style="background-color: rgba(59, 130, 246, 0.1); color: var(--info-color);">
                        <i class="fas fa-file-alt fa-2x"></i>
                    </div>
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Total Documents</div>
                        <div class="fs-4 fw-bold text-dark">@Model.TotalDocuments</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card shadow-sm border h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="stat-icon-wrapper rounded p-3 me-3" style="background-color: rgba(16, 185, 129, 0.1); color: var(--success-color);">
                        <i class="fas fa-check-circle fa-2x"></i>
                    </div>
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Indexed Documents</div>
                        <div class="fs-4 fw-bold text-dark">@Model.TotalIndexedDocuments</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card shadow-sm border h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="stat-icon-wrapper rounded p-3 me-3" style="background-color: rgba(245, 158, 11, 0.1); color: var(--warning-color);">
                        <i class="fas fa-vector-square fa-2x"></i>
                    </div>
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Vector Chunks</div>
                        <div class="fs-4 fw-bold text-dark">@Model.TotalChunks</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Knowledge Bases Table -->
    <div class="card shadow-sm border">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0 fw-semibold text-dark">
                <i class="fas fa-list text-primary me-2"></i>All Knowledge Bases
            </h5>
            <span class="badge badge-secondary">@Model.TotalKnowledgeBases total</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th style="min-width: 220px;">Name</th>
                        <th>Documents</th>
                        <th>Chunks</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th class="text-end" style="min-width: 260px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.KnowledgeBases.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <div class="py-3">
                                    <i class="fas fa-folder-open fa-3x text-secondary mb-3 opacity-50"></i>
                                    <h6>No knowledge bases found</h6>
                                    <p class="small text-muted mb-3">Create your first knowledge base to upload recruitment guidelines, policies, and documents.</p>
                                    @if (User.HasClaim("Permission", "ManageKnowledgeBases") || User.IsInRole("Admin"))
                                    {
                                        <a asp-action="Create" class="btn btn-sm btn-primary">
                                            <i class="fas fa-plus me-1"></i> Create Knowledge Base
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.KnowledgeBases)
                        {
                            <tr>
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="fw-semibold text-dark text-decoration-none">
                                        @item.Name
                                    </a>
                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <div class="small text-muted text-truncate" style="max-width: 320px;">@item.Description</div>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-1">
                                        <span class="fw-semibold">@item.DocumentCount</span>
                                        <span class="text-muted small">total</span>
                                        @if (item.IndexedDocumentCount > 0)
                                        {
                                            <span class="badge badge-success ms-1">@item.IndexedDocumentCount indexed</span>
                                        }
                                        @if (item.FailedDocumentCount > 0)
                                        {
                                            <span class="badge badge-danger ms-1">@item.FailedDocumentCount failed</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="fw-semibold">@item.TotalChunks</span>
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge badge-success"><i class="fas fa-check me-1"></i>Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary"><i class="fas fa-pause me-1"></i>Inactive</span>
                                    }
                                </td>
                                <td>
                                    <span class="text-muted small">@item.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Documents" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Manage Documents">
                                            <i class="fas fa-file-upload me-1"></i> Documents
                                        </a>
                                        @if (User.HasClaim("Permission", "AskKnowledgeBases") || User.IsInRole("Admin"))
                                        {
                                            <a asp-controller="KnowledgeBaseChat" asp-action="Session" asp-route-knowledgeBaseId="@item.Id" class="btn btn-outline-secondary" title="Ask Questions">
                                                <i class="fas fa-comments me-1"></i> Chat
                                            </a>
                                        }
                                        @if (User.HasClaim("Permission", "ManageKnowledgeBases") || User.IsInRole("Admin"))
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.Id" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        }
                                    </div>

                                    @if (User.HasClaim("Permission", "ManageKnowledgeBases") || User.IsInRole("Admin"))
                                    {
                                        <!-- Delete Confirmation Modal -->
                                        <div class="modal fade" id="deleteModal-@item.Id" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title">Delete Knowledge Base</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body text-start">
                                                        <p>Are you sure you want to delete <strong>@item.Name</strong>?</p>
                                                        <p class="text-muted small mb-0">This will remove all associated documents, local files, chat sessions, and the vectors stored in the Pinecone index.</p>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-danger">Delete Knowledge Base</button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
