@model RecruitmentPortal.Models.ViewModels.KnowledgeBaseDocumentsViewModel

@{
    ViewData["Title"] = $"{Model.KnowledgeBaseName} - Documents";
}

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h1 class="h3 fw-bold text-dark mb-0">@Model.KnowledgeBaseName</h1>
                <span class="badge badge-secondary">Document Management</span>
            </div>
            <p class="text-muted mb-0">Upload PDF and Word (DOCX) documents to parse, chunk, embed, and index into Pinecone vector storage.</p>
        </div>
        <div class="d-flex gap-2">
            @if (User.HasClaim("Permission", "AskKnowledgeBases") || User.IsInRole("Admin"))
            {
                <a asp-controller="KnowledgeBaseChat" asp-action="Session" asp-route-knowledgeBaseId="@Model.KnowledgeBaseId" class="btn btn-outline-secondary">
                    <i class="fas fa-comments me-1"></i> Open Chatbot
                </a>
            }
            <a asp-action="Details" asp-route-id="@Model.KnowledgeBaseId" class="btn btn-outline-secondary">
                <i class="fas fa-info-circle me-1"></i> Details
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> Back to List
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show mb-4" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i> @TempData["WarningMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="fas fa-times-circle me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Upload Card -->
    @if (User.HasClaim("Permission", "ManageKnowledgeBases") || User.IsInRole("Admin"))
    {
        <div class="card shadow-sm border mb-4">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="card-title mb-0 fw-semibold text-dark">
                    <i class="fas fa-cloud-upload-alt text-primary me-2"></i>Upload Documents
                </h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="UploadDocuments" asp-route-id="@Model.KnowledgeBaseId" method="post" enctype="multipart/form-data" id="uploadForm">
                    @Html.AntiForgeryToken()

                    <div class="upload-dropzone p-4 text-center border rounded bg-light mb-3" id="dropZone" style="border-style: dashed !important; cursor: pointer;">
                        <i class="fas fa-file-upload fa-3x text-primary mb-3"></i>
                        <h6 class="fw-semibold text-dark mb-1">Click to browse or drag & drop documents here</h6>
                        <p class="text-muted small mb-2">Supported formats: <strong>PDF (.pdf)</strong> and <strong>Word (.docx)</strong></p>
                        <span class="badge badge-secondary">Maximum file size: @Model.MaxFileSizeMB MB per file</span>
                        <input type="file" name="files" id="fileInput" class="d-none" multiple accept=".pdf,.docx,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                    </div>

                    <div id="fileListContainer" class="d-none mb-3">
                        <h6 class="small fw-semibold text-muted text-uppercase mb-2">Selected Files to Upload:</h6>
                        <ul class="list-group list-group-flush border rounded" id="selectedFilesList"></ul>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary" id="btnUploadSubmit" disabled>
                            <i class="fas fa-upload me-1"></i> Upload & Start Ingestion
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }

    <!-- Documents Table -->
    <div class="card shadow-sm border">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0 fw-semibold text-dark">
                <i class="fas fa-folder text-primary me-2"></i>Ingested Documents (@Model.Documents.Count)
            </h5>
            <div class="d-flex gap-2">
                <span class="badge badge-success">@Model.Documents.Count(d => d.Status == RecruitmentPortal.Models.Enums.KnowledgeBaseDocumentStatus.Indexed) Indexed</span>
                @if (Model.Documents.Any(d => d.Status == RecruitmentPortal.Models.Enums.KnowledgeBaseDocumentStatus.Failed))
                {
                    <span class="badge badge-danger">@Model.Documents.Count(d => d.Status == RecruitmentPortal.Models.Enums.KnowledgeBaseDocumentStatus.Failed) Failed</span>
                }
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th style="min-width: 240px;">Document Name</th>
                        <th>Size</th>
                        <th>Status</th>
                        <th>Chunks</th>
                        <th>Uploaded By</th>
                        <th>Uploaded At</th>
                        <th class="text-end" style="min-width: 180px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Documents.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="fas fa-inbox fa-3x text-secondary mb-3 opacity-50"></i>
                                <h6>No documents uploaded yet</h6>
                                <p class="small text-muted mb-0">Use the upload box above to add PDF and DOCX files to this knowledge base.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var doc in Model.Documents)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <i class="fas @(doc.FileExtension == ".pdf" ? "fa-file-pdf text-danger" : "fa-file-word text-primary") fa-lg me-2"></i>
                                        <div>
                                            <span class="fw-semibold text-dark">@doc.FileName</span>
                                            @if (doc.Status == RecruitmentPortal.Models.Enums.KnowledgeBaseDocumentStatus.Failed && !string.IsNullOrWhiteSpace(doc.ErrorMessage))
                                            {
                                                <div class="text-danger small mt-1">
                                                    <i class="fas fa-exclamation-circle me-1"></i> @doc.ErrorMessage
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td><span class="text-muted small">@doc.FormattedFileSize</span></td>
                                <td>
                                    @switch (doc.Status)
                                    {
                                        case RecruitmentPortal.Models.Enums.KnowledgeBaseDocumentStatus.Indexed:
                                            <span class="badge badge-success"><i class="fas fa-check-circle me-1"></i>Indexed</span>
                                            break;
                                        case RecruitmentPortal.Models.Enums.KnowledgeBaseDocumentStatus.Indexing:
                                            <span class="badge badge-warning"><i class="fas fa-spinner fa-spin me-1"></i>Indexing</span>
                                            break;
                                        case RecruitmentPortal.Models.Enums.KnowledgeBaseDocumentStatus.Parsing:
                                            <span class="badge badge-warning"><i class="fas fa-spinner fa-spin me-1"></i>Parsing</span>
                                            break;
                                        case RecruitmentPortal.Models.Enums.KnowledgeBaseDocumentStatus.Parsed:
                                            <span class="badge badge-info"><i class="fas fa-file-code me-1"></i>Parsed</span>
                                            break;
                                        case RecruitmentPortal.Models.Enums.KnowledgeBaseDocumentStatus.Uploaded:
                                            <span class="badge badge-info"><i class="fas fa-cloud-upload-alt me-1"></i>Uploaded</span>
                                            break;
                                        case RecruitmentPortal.Models.Enums.KnowledgeBaseDocumentStatus.Failed:
                                            <span class="badge badge-danger"><i class="fas fa-exclamation-triangle me-1"></i>Failed</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <span class="fw-semibold">@doc.ChunkCount</span>
                                </td>
                                <td><span class="text-muted small">@(doc.UploadedByName ?? "System")</span></td>
                                <td><span class="text-muted small">@doc.UploadedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</span></td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm" role="group">
                                        @if (User.HasClaim("Permission", "ManageKnowledgeBases") || User.IsInRole("Admin"))
                                        {
                                            <form asp-action="ReindexDocument" asp-route-id="@Model.KnowledgeBaseId" asp-route-documentId="@doc.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-secondary" title="@(doc.Status == RecruitmentPortal.Models.Enums.KnowledgeBaseDocumentStatus.Failed ? "Retry Ingestion" : "Reindex Document")">
                                                    <i class="fas fa-sync-alt me-1"></i> @(doc.Status == RecruitmentPortal.Models.Enums.KnowledgeBaseDocumentStatus.Failed ? "Retry" : "Reindex")
                                                </button>
                                            </form>
                                            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteDocModal-@doc.Id" title="Delete Document">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        }
                                    </div>

                                    @if (User.HasClaim("Permission", "ManageKnowledgeBases") || User.IsInRole("Admin"))
                                    {
                                        <!-- Delete Document Modal -->
                                        <div class="modal fade" id="deleteDocModal-@doc.Id" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title">Delete Document</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body text-start">
                                                        <p>Are you sure you want to delete <strong>@doc.FileName</strong>?</p>
                                                        <p class="text-muted small mb-0">This document will be removed from local storage and its vectors will be deleted from the Pinecone vector index.</p>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                        <form asp-action="DeleteDocument" asp-route-id="@Model.KnowledgeBaseId" asp-route-documentId="@doc.Id" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-danger">Delete Document</button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            var dropZone = $('#dropZone');
            var fileInput = $('#fileInput');
            var fileList = $('#selectedFilesList');
            var fileListContainer = $('#fileListContainer');
            var submitBtn = $('#btnUploadSubmit');

            dropZone.on('click', function () {
                fileInput.click();
            });

            dropZone.on('dragover', function (e) {
                e.preventDefault();
                e.stopPropagation();
                dropZone.addClass('border-primary');
            });

            dropZone.on('dragleave', function (e) {
                e.preventDefault();
                e.stopPropagation();
                dropZone.removeClass('border-primary');
            });

            dropZone.on('drop', function (e) {
                e.preventDefault();
                e.stopPropagation();
                dropZone.removeClass('border-primary');

                if (e.originalEvent.dataTransfer && e.originalEvent.dataTransfer.files.length) {
                    fileInput[0].files = e.originalEvent.dataTransfer.files;
                    updateFileList();
                }
            });

            fileInput.on('change', function () {
                updateFileList();
            });

            function updateFileList() {
                var files = fileInput[0].files;
                fileList.empty();

                if (!files || files.length === 0) {
                    fileListContainer.addClass('d-none');
                    submitBtn.prop('disabled', true);
                    return;
                }

                fileListContainer.removeClass('d-none');
                submitBtn.prop('disabled', false);

                for (var i = 0; i < files.length; i++) {
                    var f = files[i];
                    var sizeMb = (f.size / (1024 * 1024)).toFixed(2);
                    var icon = f.name.endsWith('.pdf') ? 'fa-file-pdf text-danger' : 'fa-file-word text-primary';
                    var item = $('<li class="list-group-item d-flex justify-content-between align-items-center py-2 px-3 small">' +
                        '<div><i class="fas ' + icon + ' me-2"></i><strong>' + $('<div>').text(f.name).html() + '</strong></div>' +
                        '<span class="text-muted">' + sizeMb + ' MB</span>' +
                        '</li>');
                    fileList.append(item);
                }
            }

            $('#uploadForm').on('submit', function () {
                submitBtn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Ingesting Documents...');
            });
        });
    </script>
}
