@model IEnumerable<RecruitmentPortal.Models.CandidateEvaluationForm>
@{
    ViewData["Title"] = "Evaluation Forms";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1 class="page-title">Evaluation Forms</h1>
        <p class="page-subtitle text-muted">All candidate evaluation form submissions</p>
    </div>
    <a href="/CandidateEvaluationForms/Create" target="_blank" class="btn btn-primary">
        <i class="fas fa-external-link-alt me-2"></i>Open Public Form
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <!-- Search bar -->
        <div class="p-3 border-bottom">
            <form method="get" class="d-flex gap-2">
                <div class="d-flex gap-2" style="max-width:320px;">
                    <input type="text" name="search" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Search by name, email or position…" />
                    <button type="submit" class="btn btn-outline-primary"><i class="fas fa-search"></i></button>
                </div>
                <select name="status" class="form-select" style="max-width:200px;" onchange="this.form.submit()">
                    <option value="">All Statuses</option>
                    @foreach (var status in Enum.GetValues<RecruitmentPortal.Models.EvaluationStatus>())
                    {
                        <option value="@status" selected="@(ViewData["CurrentStatus"]?.ToString() == status.ToString())">@status</option>
                    }
                </select>
                @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString()) || ViewData["CurrentStatus"] != null)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                }
            </form>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="fas fa-clipboard-list fa-3x mb-3 d-block"></i>
                No evaluation forms submitted yet.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Full Name</th>
                            <th>Email</th>
                            <th>Position Applied</th>
                            <th>Interview Date</th>
                            <th>Evaluation Status</th>
                            <th>Submitted</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var form in Model)
                        {
                            <tr>
                                <td class="text-muted">#@form.Id</td>
                                <td class="fw-semibold">@form.FullName</td>
                                <td>@form.Email</td>
                                <td>@form.PositionAppliedFor</td>
                                <td>@(form.InterviewDate?.ToString("dd MMM yyyy") ?? "—")</td>
                                <td>
                                    @{
                                        var statusClass = form.EvaluationStatus switch
                                        {
                                            RecruitmentPortal.Models.EvaluationStatus.Pending => "badge-yellow",
                                            RecruitmentPortal.Models.EvaluationStatus.Shortlisted => "badge-success",
                                            RecruitmentPortal.Models.EvaluationStatus.OnHold => "badge-blue",
                                            RecruitmentPortal.Models.EvaluationStatus.Rejected => "badge-red",
                                            _ => "badge-gray"
                                        };
                                    }
                                    <span class="badge @statusClass">@form.EvaluationStatus</span>
                                </td>
                                <td class="text-muted small">@form.SubmittedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@form.Id" class="btn btn-sm btn-outline-primary me-1" title="View">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    @if (User.HasClaim("Permission", "EditEvaluationForms"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@form.Id" class="btn btn-sm btn-outline-warning me-1" title="Edit">
                                            <i class="fas fa-pen"></i>
                                        </a>
                                    }
                                    @if (User.HasClaim("Permission", "DeleteEvaluationForms"))
                                    {
                                        <a asp-action="Delete" asp-route-id="@form.Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
