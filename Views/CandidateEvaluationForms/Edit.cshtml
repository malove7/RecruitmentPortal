@model RecruitmentPortal.Models.ViewModels.CandidateEvaluationFormViewModel
@{
    ViewData["Title"] = "Edit Evaluation Form";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1 class="page-title">Edit Evaluation Form</h1>
        <p class="page-subtitle text-muted">@Model.FullName</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Back to List
    </a>
</div>

<form asp-action="Edit" method="post" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <!-- Personal Information -->
    <div class="card shadow-sm mb-3">
        <div class="card-header fw-semibold"><i class="fas fa-user me-2 text-primary"></i>Personal Information</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label">Email ID <span class="text-danger">*</span></label>
                    <input asp-for="Email" class="form-control" type="email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label">Full Name <span class="text-danger">*</span></label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="InterviewDate" class="form-label">Interview Date</label>
                    <input asp-for="InterviewDate" class="form-control" type="date" />
                </div>
                <div class="col-md-6">
                    <label asp-for="InterviewTime" class="form-label">Interview Time</label>
                    <input asp-for="InterviewTime" class="form-control" type="time" />
                </div>
                <div class="col-md-6">
                    <label asp-for="PositionAppliedFor" class="form-label">Position Applied For <span class="text-danger">*</span></label>
                    <input asp-for="PositionAppliedFor" class="form-control" />
                    <span asp-validation-for="PositionAppliedFor" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="DateOfBirth" class="form-label">Date of Birth</label>
                    <input asp-for="DateOfBirth" class="form-control" type="date" />
                </div>
                <div class="col-md-6">
                    <label asp-for="TotalExperience" class="form-label">Total Experience (Years)</label>
                    <input asp-for="TotalExperience" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="RelevantIndustryExperience" class="form-label">Relevant Industry Experience</label>
                    <input asp-for="RelevantIndustryExperience" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="ContactNumber" class="form-label">Contact Number</label>
                    <input asp-for="ContactNumber" class="form-control" type="tel" />
                </div>
                <div class="col-md-6">
                    <label asp-for="NoticePeriod" class="form-label">Notice Period</label>
                    <input asp-for="NoticePeriod" class="form-control" />
                </div>
                <div class="col-12">
                    <label asp-for="ResidenceAddress" class="form-label">Residence Address</label>
                    <textarea asp-for="ResidenceAddress" class="form-control" rows="2"></textarea>
                </div>
                <div class="col-md-6">
                    <label asp-for="CurrentOrganization" class="form-label">Current Organization</label>
                    <input asp-for="CurrentOrganization" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="ExpectedCTC" class="form-label">Expected CTC</label>
                    <input asp-for="ExpectedCTC" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="OfferedCTC" class="form-label">Offered CTC</label>
                    <input asp-for="OfferedCTC" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="JoiningDate" class="form-label">Joining Date</label>
                    <input asp-for="JoiningDate" class="form-control" type="date" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Married" class="form-label">Married</label>
                    <div class="d-flex gap-4 mt-1">
                        <div class="form-check">
                            <input asp-for="Married" class="form-check-input" type="radio" id="marriedYes" value="true" />
                            <label class="form-check-label" for="marriedYes">Yes</label>
                        </div>
                        <div class="form-check">
                            <input asp-for="Married" class="form-check-input" type="radio" id="marriedNo" value="false" />
                            <label class="form-check-label" for="marriedNo">No</label>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <label asp-for="Child" class="form-label">Child</label>
                    <div class="d-flex gap-4 mt-1">
                        <div class="form-check">
                            <input asp-for="Child" class="form-check-input" type="radio" id="childYes" value="true" />
                            <label class="form-check-label" for="childYes">Yes</label>
                        </div>
                        <div class="form-check">
                            <input asp-for="Child" class="form-check-input" type="radio" id="childNo" value="false" />
                            <label class="form-check-label" for="childNo">No</label>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <label asp-for="PreviouslyInterviewed" class="form-label">Previously Interviewed by Spacestem?</label>
                    <div class="d-flex gap-4 mt-1">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="PreviouslyInterviewed" id="piYes" value="true"
                                   @(Model.PreviouslyInterviewed == true ? "checked" : "") />
                            <label class="form-check-label" for="piYes">Yes</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="PreviouslyInterviewed" id="piNo" value="false"
                                   @(Model.PreviouslyInterviewed == false ? "checked" : "") />
                            <label class="form-check-label" for="piNo">No</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Work Experience -->
    <div class="card shadow-sm mb-3">
        <div class="card-header fw-semibold"><i class="fas fa-briefcase me-2 text-primary"></i>Work Experience</div>
        <div class="card-body">
            @for (int i = 0; i < Model.WorkExperiences.Count; i++)
            {
                <div class="border rounded p-3 mb-3 bg-light">
                    <div class="fw-semibold text-primary small text-uppercase mb-2">Employment Record @(i + 1)</div>
                    <input type="hidden" name="WorkExperiences[@i].RecordNumber" value="@(i + 1)" />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Company Name</label>
                            <input name="WorkExperiences[@i].CompanyName" value="@Model.WorkExperiences[i].CompanyName" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Designation</label>
                            <input name="WorkExperiences[@i].Designation" value="@Model.WorkExperiences[i].Designation" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Start Date</label>
                            <input name="WorkExperiences[@i].StartDate" value="@(Model.WorkExperiences[i].StartDate?.ToString("yyyy-MM-dd"))" type="date" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">End Date</label>
                            <input name="WorkExperiences[@i].EndDate" value="@(Model.WorkExperiences[i].EndDate?.ToString("yyyy-MM-dd"))" type="date" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Duration</label>
                            <input name="WorkExperiences[@i].DurationOfWork" value="@Model.WorkExperiences[i].DurationOfWork" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Last CTC Per Annum</label>
                            <input name="WorkExperiences[@i].LastCTCPerAnnum" value="@Model.WorkExperiences[i].LastCTCPerAnnum" class="form-control" />
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Education -->
    <div class="card shadow-sm mb-3">
        <div class="card-header fw-semibold"><i class="fas fa-graduation-cap me-2 text-primary"></i>Education Details</div>
        <div class="card-body">
            @for (int i = 0; i < Model.EducationRecords.Count; i++)
            {
                <div class="border rounded p-3 mb-3 bg-light">
                    <div class="fw-semibold text-primary small text-uppercase mb-2">Degree / Course @(i + 1)</div>
                    <input type="hidden" name="EducationRecords[@i].RecordNumber" value="@(i + 1)" />
                    <div class="row g-3">
                        <div class="col-md-5">
                            <label class="form-label">Degree / Course</label>
                            <input name="EducationRecords[@i].DegreeCourse" value="@Model.EducationRecords[i].DegreeCourse" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Year of Passing</label>
                            <input name="EducationRecords[@i].YearOfPassing" value="@Model.EducationRecords[i].YearOfPassing" class="form-control" maxlength="4" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Division / Percentage</label>
                            <input name="EducationRecords[@i].DivisionPercentage" value="@Model.EducationRecords[i].DivisionPercentage" class="form-control" />
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Declaration -->
    <div class="card shadow-sm mb-3">
        <div class="card-header fw-semibold"><i class="fas fa-file-signature me-2 text-primary"></i>Declaration</div>
        <div class="card-body">
            <div class="form-check mb-3">
                <input asp-for="Declaration" class="form-check-input" type="checkbox" />
                <label asp-for="Declaration" class="form-check-label">
                    Candidate declared information is true and correct.
                </label>
            </div>
            <div class="col-md-6">
                <label asp-for="DigitalSignature" class="form-label">Digital Signature</label>
                <input asp-for="DigitalSignature" class="form-control" />
            </div>
        </div>
    </div>

    <!-- HR Evaluation -->
    <div class="card shadow-sm mb-3">
        <div class="card-header fw-semibold"><i class="fas fa-user-tie me-2 text-primary"></i>HR Evaluation</div>
        <div class="card-body">
            <div class="row g-4">
                <div class="col-md-6">
                    <label class="form-label">Communication Skills (0–10)</label>
                    <div class="d-flex align-items-center gap-2">
                        <input asp-for="CommunicationSkills" type="range" min="0" max="10" class="form-range flex-grow-1"
                               oninput="document.getElementById('commVal').textContent=this.value" />
                        <span class="badge bg-primary" id="commVal" style="min-width:2rem;font-size:1rem;">@Model.CommunicationSkills</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Confidence (0–10)</label>
                    <div class="d-flex align-items-center gap-2">
                        <input asp-for="Confidence" type="range" min="0" max="10" class="form-range flex-grow-1"
                               oninput="document.getElementById('confVal').textContent=this.value" />
                        <span class="badge bg-success" id="confVal" style="min-width:2rem;font-size:1rem;">@Model.Confidence</span>
                    </div>
                </div>
                <div class="col-12">
                    <label asp-for="HRComments" class="form-label">HR Comments</label>
                    <textarea asp-for="HRComments" class="form-control" rows="3"></textarea>
                </div>
                <div class="col-md-6">
                    <label asp-for="HRSignature" class="form-label">HR Signature</label>
                    <input asp-for="HRSignature" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="EvaluationStatus" class="form-label">Evaluation Status</label>
                    <select asp-for="EvaluationStatus" class="form-select" asp-items="Html.GetEnumSelectList<RecruitmentPortal.Models.EvaluationStatus>()"></select>
                </div>
            </div>
        </div>
    </div>

    <!-- Technical Evaluations -->
    <div class="card shadow-sm mb-3">
        <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
            <div>
                <i class="fas fa-laptop-code me-2 text-primary"></i>Technical Evaluations
            </div>
            <button type="button" class="btn btn-sm btn-outline-primary" id="btnAddTechnicalEvaluation">
                <i class="fas fa-plus me-1"></i>Add Interviewer Feedback
            </button>
        </div>
        <div class="card-body">
            <div id="technicalEvaluationsContainer">
                @for (int i = 0; i < Model.TechnicalEvaluations.Count; i++)
                {
                    <div class="border rounded p-3 mb-3 bg-light tech-eval-card" data-index="@i">
                        <input type="hidden" name="TechnicalEvaluations.Index" value="@i" />
                        <input type="hidden" name="TechnicalEvaluations[@i].Id" value="@Model.TechnicalEvaluations[i].Id" />
                        <input type="hidden" name="TechnicalEvaluations[@i].RecordNumber" class="tech-record-number" value="@(i + 1)" />
                        <input type="hidden" name="TechnicalEvaluations[@i].EvaluatedAt" value="@(Model.TechnicalEvaluations[i].EvaluatedAt?.ToString("o"))" />

                        <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                            <div class="fw-semibold text-primary small text-uppercase tech-eval-title">
                                Interviewer Feedback #@(i + 1)
                                @if (Model.TechnicalEvaluations[i].EvaluatedAt is DateTime evaluatedAt)
                                {
                                    <span class="text-muted text-lowercase fw-normal ms-2 tech-eval-time">
                                        (@evaluatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm"))
                                    </span>
                                }
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-danger btn-remove-tech-eval" title="Remove feedback">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Interviewer Name / Signature</label>
                                <input name="TechnicalEvaluations[@i].TechnicalReviewerSignature" value="@Model.TechnicalEvaluations[i].TechnicalReviewerSignature" class="form-control" placeholder="e.g. John Doe" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Technical Comments</label>
                                <textarea name="TechnicalEvaluations[@i].TechnicalComments" class="form-control" rows="3" placeholder="Enter technical feedback...">@Model.TechnicalEvaluations[i].TechnicalComments</textarea>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div id="noTechEvalsAlert" class="text-muted small @(Model.TechnicalEvaluations.Any() ? "d-none" : "")">
                <i class="fas fa-info-circle me-1"></i>No interviewer feedback recorded yet. Click <strong>"Add Interviewer Feedback"</strong> to add an evaluation manually or share a feedback link with interviewers.
            </div>
        </div>
    </div>

    <!-- Other -->
    <div class="card shadow-sm mb-3">
        <div class="card-header fw-semibold"><i class="fas fa-comment-alt me-2 text-primary"></i>Other Comments</div>
        <div class="card-body">
            <textarea asp-for="OtherComments" class="form-control" rows="3"></textarea>
        </div>
    </div>

    <div class="d-flex gap-2 mb-4">
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save me-1"></i>Save Changes
        </button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const container = document.getElementById('technicalEvaluationsContainer');
            const btnAdd = document.getElementById('btnAddTechnicalEvaluation');
            const noAlert = document.getElementById('noTechEvalsAlert');

            function updateCardIndices() {
                const cards = container.querySelectorAll('.tech-eval-card');
                if (cards.length === 0) {
                    if (noAlert) noAlert.classList.remove('d-none');
                } else {
                    if (noAlert) noAlert.classList.add('d-none');
                }

                cards.forEach((card, index) => {
                    card.setAttribute('data-index', index);

                    const titleSpan = card.querySelector('.tech-eval-title');
                    const timeSpan = card.querySelector('.tech-eval-time');
                    const timeHtml = timeSpan ? timeSpan.outerHTML : '';
                    if (titleSpan) {
                        titleSpan.innerHTML = `Interviewer Feedback #${index + 1} ${timeHtml}`;
                    }

                    const recordNumInput = card.querySelector('.tech-record-number');
                    if (recordNumInput) {
                        recordNumInput.value = index + 1;
                        recordNumInput.setAttribute('name', `TechnicalEvaluations[${index}].RecordNumber`);
                    }

                    const indexInput = card.querySelector('input[name="TechnicalEvaluations.Index"]');
                    if (indexInput) {
                        indexInput.value = index;
                    }

                    const idInput = card.querySelector('input[name$=".Id"]');
                    if (idInput) {
                        idInput.setAttribute('name', `TechnicalEvaluations[${index}].Id`);
                    }

                    const evaluatedAtInput = card.querySelector('input[name$=".EvaluatedAt"]');
                    if (evaluatedAtInput) {
                        evaluatedAtInput.setAttribute('name', `TechnicalEvaluations[${index}].EvaluatedAt`);
                    }

                    const sigInput = card.querySelector('input[name$=".TechnicalReviewerSignature"]');
                    if (sigInput) {
                        sigInput.setAttribute('name', `TechnicalEvaluations[${index}].TechnicalReviewerSignature`);
                    }

                    const commentsInput = card.querySelector('textarea[name$=".TechnicalComments"]');
                    if (commentsInput) {
                        commentsInput.setAttribute('name', `TechnicalEvaluations[${index}].TechnicalComments`);
                    }
                });
            }

            if (btnAdd) {
                btnAdd.addEventListener('click', function () {
                    const cards = container.querySelectorAll('.tech-eval-card');
                    const nextIndex = cards.length;
                    const nextNum = nextIndex + 1;

                    const newCard = document.createElement('div');
                    newCard.className = 'border rounded p-3 mb-3 bg-light tech-eval-card';
                    newCard.setAttribute('data-index', nextIndex);
                    newCard.innerHTML = `
                        <input type="hidden" name="TechnicalEvaluations.Index" value="${nextIndex}" />
                        <input type="hidden" name="TechnicalEvaluations[${nextIndex}].Id" value="0" />
                        <input type="hidden" name="TechnicalEvaluations[${nextIndex}].RecordNumber" class="tech-record-number" value="${nextNum}" />
                        <input type="hidden" name="TechnicalEvaluations[${nextIndex}].EvaluatedAt" value="${new Date().toISOString()}" />

                        <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                            <div class="fw-semibold text-primary small text-uppercase tech-eval-title">
                                Interviewer Feedback #${nextNum}
                                <span class="text-muted text-lowercase fw-normal ms-2 tech-eval-time">
                                    (Just now)
                                </span>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-danger btn-remove-tech-eval" title="Remove feedback">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Interviewer Name / Signature</label>
                                <input name="TechnicalEvaluations[${nextIndex}].TechnicalReviewerSignature" class="form-control" placeholder="e.g. John Doe" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Technical Comments</label>
                                <textarea name="TechnicalEvaluations[${nextIndex}].TechnicalComments" class="form-control" rows="3" placeholder="Enter technical feedback..."></textarea>
                            </div>
                        </div>
                    `;

                    container.appendChild(newCard);
                    updateCardIndices();
                });
            }

            if (container) {
                container.addEventListener('click', function (e) {
                    const removeBtn = e.target.closest('.btn-remove-tech-eval');
                    if (removeBtn) {
                        const card = removeBtn.closest('.tech-eval-card');
                        if (card) {
                            card.remove();
                            updateCardIndices();
                        }
                    }
                });
            }
        });
    </script>
}
