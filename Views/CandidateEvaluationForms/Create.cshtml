@model RecruitmentPortal.Models.ViewModels.CandidateEvaluationFormViewModel
@{
    ViewData["Title"] = "Candidate Information & Evaluation Form";
    Layout = "_PublicLayout";
}

<div class="form-header-card">
    <div class="form-brand">SPACESTEM</div>
    <h1>Candidate Information &amp; Evaluation Form</h1>
    <p>Please fill in all required fields accurately. Fields marked <span style="color:#ffd6d6;">*</span> are mandatory.</p>
</div>

<form asp-action="Create" method="post" novalidate id="candidate-evaluation-form">
    @Html.AntiForgeryToken()
    <input asp-for="SubmissionToken" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <!-- Personal Information -->
    <div class="section-card">
        <div class="section-title"><i class="fas fa-user me-2"></i>Personal Information</div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Email" class="form-label">Email ID <span class="required-star">*</span></label>
                <input asp-for="Email" class="form-control" type="email" placeholder="your@email.com" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="FullName" class="form-label">Full Name <span class="required-star">*</span></label>
                <input asp-for="FullName" class="form-control" placeholder="As on official documents" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="InterviewDate" class="form-label">Interview Date</label>
                <input asp-for="InterviewDate" class="form-control" type="date" />
            </div>
            <div class="col-md-6">
                <label asp-for="InterviewTime" class="form-label">Interview Time</label>
                <input asp-for="InterviewTime" class="form-control" type="time" />
            </div>
            <div class="col-md-6">
                <label asp-for="PositionAppliedFor" class="form-label">Position Applied For <span class="required-star">*</span></label>
                <input asp-for="PositionAppliedFor" class="form-control" placeholder="e.g. Software Engineer" />
                <span asp-validation-for="PositionAppliedFor" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="DateOfBirth" class="form-label">Date of Birth</label>
                <input asp-for="DateOfBirth" class="form-control" type="date" />
            </div>
            <div class="col-md-6">
                <label asp-for="TotalExperience" class="form-label">Total Experience (Years)</label>
                <input asp-for="TotalExperience" class="form-control" placeholder="e.g. 4.5" />
            </div>
            <div class="col-md-6">
                <label asp-for="RelevantIndustryExperience" class="form-label">Relevant Industry Experience</label>
                <input asp-for="RelevantIndustryExperience" class="form-control" placeholder="e.g. 2 years in FinTech" />
            </div>
            <div class="col-md-6">
                <label asp-for="ContactNumber" class="form-label">Contact Number</label>
                <input asp-for="ContactNumber" class="form-control" type="tel" placeholder="+91 98765 43210" />
            </div>
            <div class="col-md-6">
                <label asp-for="NoticePeriod" class="form-label">Notice Period</label>
                <input asp-for="NoticePeriod" class="form-control" placeholder="e.g. 30 days / Immediate" />
            </div>
            <div class="col-12">
                <label asp-for="ResidenceAddress" class="form-label">Residence Address</label>
                <textarea asp-for="ResidenceAddress" class="form-control" rows="2" placeholder="Current residential address"></textarea>
            </div>
            <div class="col-md-6">
                <label asp-for="CurrentOrganization" class="form-label">Name of Current Organization</label>
                <input asp-for="CurrentOrganization" class="form-control" placeholder="Current employer" />
            </div>
            <div class="col-md-6">
                <label asp-for="ExpectedCTC" class="form-label">Expected CTC</label>
                <input asp-for="ExpectedCTC" class="form-control" placeholder="e.g. 6 LPA" />
            </div>
            <div class="col-md-6">
                <label asp-for="Married" class="form-label">Married</label>
                <div class="d-flex gap-4 mt-1">
                    <div class="form-check">
                        <input asp-for="Married" class="form-check-input" type="radio" id="marriedYes" value="true" />
                        <label class="form-check-label" for="marriedYes">Yes</label>
                    </div>
                    <div class="form-check">
                        <input asp-for="Married" class="form-check-input" type="radio" id="marriedNo" value="false" />
                        <label class="form-check-label" for="marriedNo">No</label>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <label asp-for="Child" class="form-label">Child</label>
                <div class="d-flex gap-4 mt-1">
                    <div class="form-check">
                        <input asp-for="Child" class="form-check-input" type="radio" id="childYes" value="true" />
                        <label class="form-check-label" for="childYes">Yes</label>
                    </div>
                    <div class="form-check">
                        <input asp-for="Child" class="form-check-input" type="radio" id="childNo" value="false" />
                        <label class="form-check-label" for="childNo">No</label>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <label asp-for="PreviouslyInterviewed" class="form-label">Have you ever been interviewed by Spacestem?</label>
                <div class="d-flex gap-4 mt-1">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="PreviouslyInterviewed" id="piYes" value="true"
                               @(Model.PreviouslyInterviewed == true ? "checked" : "") />
                        <label class="form-check-label" for="piYes">Yes</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="PreviouslyInterviewed" id="piNo" value="false"
                               @(Model.PreviouslyInterviewed == false ? "checked" : "") />
                        <label class="form-check-label" for="piNo">No</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Work Experience -->
    <div class="section-card">
        <div class="section-title"><i class="fas fa-briefcase me-2"></i>Work Experience</div>

        @for (int i = 0; i < Model.WorkExperiences.Count; i++)
        {
            <div class="work-exp-record">
                <div class="record-label">Employment Record @(i + 1)</div>
                <input type="hidden" name="WorkExperiences[@i].RecordNumber" value="@(i + 1)" />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Company Name</label>
                        <input name="WorkExperiences[@i].CompanyName" value="@Model.WorkExperiences[i].CompanyName" class="form-control" placeholder="Organization name" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Designation</label>
                        <input name="WorkExperiences[@i].Designation" value="@Model.WorkExperiences[i].Designation" class="form-control" placeholder="Job title" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Start Date</label>
                        <input name="WorkExperiences[@i].StartDate" value="@(Model.WorkExperiences[i].StartDate?.ToString("yyyy-MM-dd"))" type="date" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">End Date</label>
                        <input name="WorkExperiences[@i].EndDate" value="@(Model.WorkExperiences[i].EndDate?.ToString("yyyy-MM-dd"))" type="date" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Duration of Work</label>
                        <input name="WorkExperiences[@i].DurationOfWork" value="@Model.WorkExperiences[i].DurationOfWork" class="form-control" placeholder="e.g. 2 years 3 months" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Last CTC Per Annum</label>
                        <input name="WorkExperiences[@i].LastCTCPerAnnum" value="@Model.WorkExperiences[i].LastCTCPerAnnum" class="form-control" placeholder="e.g. ₹6,00,000" />
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Education -->
    <div class="section-card">
        <div class="section-title"><i class="fas fa-graduation-cap me-2"></i>Education Details</div>

        @for (int i = 0; i < Model.EducationRecords.Count; i++)
        {
            <div class="edu-record">
                <div class="record-label">Degree / Course @(i + 1)</div>
                <input type="hidden" name="EducationRecords[@i].RecordNumber" value="@(i + 1)" />
                <div class="row g-3">
                    <div class="col-md-5">
                        <label class="form-label">Degree / Course</label>
                        <input name="EducationRecords[@i].DegreeCourse" value="@Model.EducationRecords[i].DegreeCourse" class="form-control" placeholder="e.g. B.Tech Computer Science" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Year of Passing</label>
                        <input name="EducationRecords[@i].YearOfPassing" value="@Model.EducationRecords[i].YearOfPassing" class="form-control" placeholder="e.g. 2019" maxlength="4" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Division / Percentage Obtained</label>
                        <input name="EducationRecords[@i].DivisionPercentage" value="@Model.EducationRecords[i].DivisionPercentage" class="form-control" placeholder="e.g. First / 78%" />
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Declaration -->
    <div class="section-card">
        <div class="section-title"><i class="fas fa-file-signature me-2"></i>Declaration</div>
        <div class="declaration-box mb-3">
            <div class="form-check">
                <input asp-for="Declaration" class="form-check-input" type="checkbox" />
                <label asp-for="Declaration" class="form-check-label fw-500">
                    I declare that the information provided above is true and correct to the best of my knowledge. I understand that any false information may result in disqualification.
                </label>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <label asp-for="DigitalSignature" class="form-label">Digital Signature <span class="text-muted">(Type Full Name)</span></label>
                <input asp-for="DigitalSignature" class="form-control" placeholder="Type your full name as signature" />
            </div>
        </div>
    </div>

    <!-- Submit -->
    <div class="section-card d-flex justify-content-between align-items-center" style="border-radius:0 0 12px 12px;">
        <button type="submit" class="btn btn-submit" id="submit-form-button">
            <i class="fas fa-paper-plane me-2"></i>Submit Form
        </button>
        <button type="reset" class="btn btn-outline-secondary">
            <i class="fas fa-undo me-2"></i>Reset
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const form = document.getElementById('candidate-evaluation-form');
            const submitButton = document.getElementById('submit-form-button');

            form.addEventListener('submit', () => {
                if (!window.jQuery || window.jQuery(form).valid()) {
                    submitButton.disabled = true;
                    submitButton.setAttribute('aria-disabled', 'true');
                    submitButton.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Submitting...';
                }
            });
        })();
    </script>
}
