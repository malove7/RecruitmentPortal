@model RecruitmentPortal.Models.ViewModels.RolePermissionsViewModel

@{
    ViewData["Title"] = "Manage Permissions";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Manage Permissions for Role: <span class="text-primary">@Model.RoleName</span></h2>
        <a asp-controller="Roles" asp-action="Index" class="btn btn-secondary">Back to Roles</a>
    </div>

    @if (Model.RoleName == "Admin")
    {
        <div class="alert alert-info shadow-sm">
            <i class="bi bi-info-circle me-2"></i>
            The <strong>Admin</strong> role inherently possesses all permissions and cannot be modified here. The selections below reflect the default administrative configuration.
        </div>
    }

    <form asp-action="Update" method="post">
        <input type="hidden" asp-for="RoleId" />
        <input type="hidden" asp-for="RoleName" />

        <div class="row">
            @{
                // Group the permissions by GroupName so we can display them nicely in separate cards
                var groupedPermissions = Model.Permissions
                    .Select((permission, index) => new { permission, index })
                    .GroupBy(x => x.permission.GroupName)
                    .OrderBy(g => g.Key);
            }

            @foreach (var group in groupedPermissions)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card shadow-sm h-100 border-top border-primary border-3">
                        <div class="card-header bg-light fw-bold text-uppercase">
                            @group.Key
                        </div>
                        <div class="card-body">
                            @foreach (var item in group)
                            {
                                <div class="form-check form-switch mb-2">
                                    <input type="hidden" asp-for="Permissions[item.index].PermissionName" />
                                    <input type="hidden" asp-for="Permissions[item.index].DisplayName" />
                                    <input type="hidden" asp-for="Permissions[item.index].GroupName" />
                                    
                                    @if (Model.RoleName == "Admin")
                                    {
                                        <input class="form-check-input" type="checkbox" role="switch" id="perm_@item.index" asp-for="Permissions[item.index].IsSelected" disabled />
                                    }
                                    else
                                    {
                                        <input class="form-check-input" type="checkbox" role="switch" id="perm_@item.index" asp-for="Permissions[item.index].IsSelected" />
                                    }
                                    <label class="form-check-label" for="perm_@item.index">
                                        @item.permission.DisplayName
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (Model.RoleName != "Admin")
        {
            <div class="form-group mt-4 mb-5 pb-5">
                <button type="submit" class="btn btn-success btn-lg px-4 shadow-sm">
                    <i class="bi bi-check-circle me-1"></i> Save Permissions
                </button>
            </div>
        }
    </form>
</div>
