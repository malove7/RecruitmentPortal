<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RecruitmentPortal</title>
    
    <!-- Favicon -->
    <link rel="shortcut icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32x32.png" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/favicon-16x16.png" asp-append-version="true" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png" asp-append-version="true" />
    <link rel="manifest" href="~/site.webmanifest" />
    
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Custom Theme Styles -->
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sidebar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RecruitmentPortal.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="d-flex" style="height: 100vh; overflow: hidden;">
        <!-- Sidebar Navigation -->
        <nav class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <a class="sidebar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-cube text-primary"></i>
                    <span>RecruitmentPortal</span>
                </a>
            </div>
            
            <div class="sidebar-menu">
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")" 
                           asp-area="" asp-controller="Home" asp-action="Index">
                            <i class="fas fa-th-large"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Candidates" ? "active" : "")" 
                           asp-area="" asp-controller="Candidates" asp-action="Index">
                            <i class="fas fa-users"></i>
                            <span>Candidates</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "JobPositions" ? "active" : "")" 
                           asp-area="" asp-controller="JobPositions" asp-action="Index">
                            <i class="fas fa-briefcase"></i>
                            <span>Job Positions</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Interviews" ? "active" : "")" 
                           asp-area="" asp-controller="Interviews" asp-action="Index">
                            <i class="fas fa-calendar-check"></i>
                            <span>Interviews</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Feedbacks" ? "active" : "")"
                           asp-area="" asp-controller="Feedbacks" asp-action="Index">
                            <i class="fas fa-comment-dots"></i>
                            <span>Feedback</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "CandidateEvaluationForms" ? "active" : "")"
                           asp-area="" asp-controller="CandidateEvaluationForms" asp-action="Index">
                            <i class="fas fa-clipboard-list"></i>
                            <span>Evaluation Forms</span>
                        </a>
                    </li>
                    
                    @if (User.IsInRole("Admin") || User.IsInRole("HR"))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AIResumeScreening" ? "active" : "")"
                               asp-area="" asp-controller="AIResumeScreening" asp-action="Index">
                                <i class="fas fa-brain"></i>
                                <span>AI Resume Screening</span>
                            </a>
                        </li>
                    }

                    @if (User.HasClaim("Permission", "ViewKnowledgeBases") || User.HasClaim("Permission", "AskKnowledgeBases") || User.IsInRole("Admin"))
                    {
                        var currentCtrl = ViewContext.RouteData.Values["Controller"]?.ToString();
                        var isKbActive = currentCtrl == "KnowledgeBases" || currentCtrl == "KnowledgeBaseChat";
                        var targetController = (User.HasClaim("Permission", "ViewKnowledgeBases") || User.IsInRole("Admin")) ? "KnowledgeBases" : "KnowledgeBaseChat";
                        <li class="nav-item">
                            <a class="nav-link @(isKbActive ? "active" : "")"
                               asp-area="" asp-controller="@targetController" asp-action="Index">
                                <i class="fas fa-book-open"></i>
                                <span>Knowledge Base</span>
                            </a>
                        </li>
                    }
                    
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item mt-3">
                            <h6 class="sidebar-heading px-3 text-muted text-uppercase mb-1" style="font-size: 0.75rem;">
                                <span>Administration</span>
                            </h6>
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Users" ? "active" : "")" 
                               asp-area="" asp-controller="Users" asp-action="Index">
                                <i class="fas fa-users-cog text-primary"></i>
                                <span>Users</span>
                            </a>
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Roles" ? "active" : "")" 
                               asp-area="" asp-controller="Roles" asp-action="Index">
                                <i class="fas fa-shield-alt text-warning"></i>
                                <span>Roles & Permissions</span>
                            </a>
                        </li>
                    }
                </ul>
            </div>
            
            <div class="sidebar-footer">
                @await Html.PartialAsync("_LoginPartial")
            </div>
        </nav>

        <!-- Main Content -->
        <main class="main-content">
            <div class="container-fluid p-0">
                @RenderBody()
            </div>
            
            <footer class="mt-5 text-muted text-center text-small">
                &copy; 2026 - RecruitmentPortal - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </footer>
        </main>
    </div>
    
    <!-- Mobile Toggle Button (Visible only on mobile) -->
    <button class="sidebar-toggler" type="button" onclick="document.getElementById('sidebar').classList.toggle('show')">
        <i class="fas fa-bars"></i>
    </button>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
