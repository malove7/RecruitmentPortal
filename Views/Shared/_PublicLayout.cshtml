<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Spacestem</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>
        body {
            background: #f0f4f8;
            font-family: 'Inter', sans-serif;
            color: #1a202c;
        }

        .form-page-wrapper {
            max-width: 860px;
            margin: 2rem auto 4rem;
            padding: 0 1rem;
        }

        .form-header-card {
            background: #4a6cf7;
            border-radius: 12px 12px 0 0;
            padding: 2rem 2.5rem;
            color: #fff;
            border-top: 6px solid #2b4de0;
        }

        .form-header-card h1 {
            font-size: 1.75rem;
            font-weight: 700;
            margin: 0 0 0.25rem;
        }

        .form-header-card p {
            margin: 0;
            opacity: 0.85;
            font-size: 0.95rem;
        }

        .form-brand {
            font-size: 1.1rem;
            font-weight: 600;
            letter-spacing: 0.05em;
            opacity: 0.9;
            margin-bottom: 0.75rem;
        }

        .form-card {
            background: #fff;
            border-radius: 0;
            padding: 2rem 2.5rem;
            border-left: 1px solid #e2e8f0;
            border-right: 1px solid #e2e8f0;
        }

        .form-card:last-of-type {
            border-radius: 0 0 12px 12px;
            border-bottom: 1px solid #e2e8f0;
            margin-bottom: 0;
        }

        .section-card {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 1.75rem 2rem;
            margin-bottom: 1.25rem;
        }

        .section-title {
            font-size: 1rem;
            font-weight: 600;
            color: #4a6cf7;
            border-bottom: 2px solid #e8eeff;
            padding-bottom: 0.6rem;
            margin-bottom: 1.25rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .sub-section-title {
            font-size: 0.85rem;
            font-weight: 600;
            color: #718096;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin: 1.25rem 0 0.75rem;
        }

        .form-label {
            font-size: 0.875rem;
            font-weight: 500;
            color: #374151;
            margin-bottom: 0.3rem;
        }

        .form-control, .form-select {
            border: 1px solid #d1d5db;
            border-radius: 6px;
            font-size: 0.875rem;
            padding: 0.5rem 0.75rem;
            transition: border-color 0.15s;
        }

        .form-control:focus, .form-select:focus {
            border-color: #4a6cf7;
            box-shadow: 0 0 0 3px rgba(74, 108, 247, 0.1);
        }

        .range-wrapper {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .range-wrapper input[type=range] {
            flex: 1;
            accent-color: #4a6cf7;
        }

        .range-value {
            min-width: 2.5rem;
            text-align: center;
            font-weight: 600;
            color: #4a6cf7;
            background: #e8eeff;
            border-radius: 6px;
            padding: 0.2rem 0.5rem;
            font-size: 0.95rem;
        }

        .range-labels {
            display: flex;
            justify-content: space-between;
            font-size: 0.75rem;
            color: #6b7280;
            margin-top: 0.25rem;
        }

        .btn-submit {
            background: #4a6cf7;
            border: none;
            color: #fff;
            font-weight: 600;
            font-size: 1rem;
            padding: 0.75rem 3rem;
            border-radius: 8px;
            transition: background 0.2s;
        }

        .btn-submit:hover {
            background: #2b4de0;
            color: #fff;
        }

        .required-star {
            color: #e53e3e;
            margin-left: 2px;
        }

        .declaration-box {
            background: #f7f8fc;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 1.25rem 1.5rem;
        }

        .work-exp-record, .edu-record {
            background: #f7f8fc;
            border: 1px solid #e8eef7;
            border-radius: 8px;
            padding: 1.25rem;
            margin-bottom: 1rem;
        }

        .record-label {
            font-size: 0.8rem;
            font-weight: 600;
            color: #4a6cf7;
            margin-bottom: 0.75rem;
        }
    </style>
</head>
<body>
    <div class="form-page-wrapper">
        @RenderBody()
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
