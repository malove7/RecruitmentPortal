@using System.Security.Claims
@using Microsoft.AspNetCore.Identity

@if (User.Identity?.IsAuthenticated == true)
{
    var firstName = User.FindFirst("FirstName")?.Value ?? "User";
    var lastName = User.FindFirst("LastName")?.Value ?? "";
    var initial = firstName.Length > 0 ? firstName.Substring(0, 1).ToUpper() : "U";
    var email = User.FindFirst(ClaimTypes.Email)?.Value ?? User.Identity.Name;

    <div class="user-profile d-flex align-items-center justify-content-between w-100">
        <div class="d-flex align-items-center min-w-0 flex-grow-1 me-2" style="overflow: hidden;">
            <div class="user-avatar rounded-circle bg-primary text-white d-flex justify-content-center align-items-center flex-shrink-0" 
                 style="width: 36px; height: 36px; font-weight: 600; font-size: 0.95rem;">
                @initial
            </div>
            <div class="user-info d-flex flex-column min-w-0 ms-2 text-truncate" style="overflow: hidden;">
                <span class="fw-semibold text-white text-truncate" style="font-size: 0.85rem; line-height: 1.25;" title="@firstName @lastName">
                    @firstName @lastName
                </span>
                <span class="text-truncate" style="font-size: 0.72rem; color: #9ca3af; line-height: 1.25;" title="@email">
                    @email
                </span>
            </div>
        </div>
        <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0 p-0 flex-shrink-0">
            <button type="submit" class="btn btn-sm btn-link text-danger p-1" title="Logout" style="line-height: 1; text-decoration: none;">
                <i class="fas fa-sign-out-alt fa-lg"></i>
            </button>
        </form>
    </div>
}
else
{
    <div class="user-profile text-center w-100">
        <a asp-controller="Auth" asp-action="Login" class="btn btn-primary btn-sm w-100">
            <i class="fas fa-sign-in-alt me-1"></i> Login
        </a>
    </div>
}
