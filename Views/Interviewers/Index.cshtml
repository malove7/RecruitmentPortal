@model IEnumerable<RecruitmentPortal.Models.Interviewer>

@{
    ViewData["Title"] = "Manage Interviewers";
}

<div class="d-flex justify-content-between align-items-center mb-4 dashboard-header">
    <div>
        <h1 class="page-title">Interviewers</h1>
        <p class="page-subtitle">Manage assessment team members.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-user-plus me-1"></i> Add Interviewer
    </a>
</div>

<div class="card shadow mb-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="border-top-0 text-muted small text-uppercase ps-4">Interviewer</th>
                        <th class="border-top-0 text-muted small text-uppercase">Email</th>
                        <th class="border-top-0 text-muted small text-uppercase">Department</th>
                         <th class="border-top-0 text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
            @foreach (var item in Model) {
                    <tr>
                         <td class="ps-4">
                            <div class="d-flex align-items-center">
                                <div class="avatar bg-soft-info text-info rounded-circle me-3 fw-bold" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                                    @item.Name.Substring(0,1)
                                </div>
                                <div>
                                    <div class="fw-medium">@Html.DisplayFor(modelItem => item.Name)</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <i class="far fa-envelope text-muted me-2"></i>@Html.DisplayFor(modelItem => item.Email)
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">@Html.DisplayFor(modelItem => item.Department)</span>
                        </td>
                        <td class="text-end pe-4">
                            <div class="btn-group">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary border-0 text-muted"><i class="fas fa-edit"></i></a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary border-0 text-muted"><i class="fas fa-eye"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger border-0"><i class="fas fa-trash"></i></a>
                            </div>
                        </td>
                    </tr>
            }
                </tbody>
            </table>
        </div>
    </div>
</div>
