@model IEnumerable<RecruitmentPortal.Models.Feedback>

@{
    ViewData["Title"] = "Manage Feedback";
}

<div class="d-flex justify-content-between align-items-center mb-4 dashboard-header">
    <div>
        <h1 class="page-title">Feedback</h1>
        <p class="page-subtitle">Review interviewer feedback.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i> Add Feedback
    </a>
</div>

<div class="card shadow mb-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="border-top-0 text-muted small text-uppercase ps-4">Interview</th>
                        <th class="border-top-0 text-muted small text-uppercase">Rating</th>
                        <th class="border-top-0 text-muted small text-uppercase" style="width: 40%;">Comments</th>
                        <th class="border-top-0 text-muted small text-uppercase">Date</th>
                        <th class="border-top-0 text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
            @foreach (var item in Model) {
                    <tr>
                         <td class="ps-4">
                            <span class="fw-medium">@item.Interview.Round - @(item.Interview.Candidate != null ? $"{item.Interview.Candidate.FirstName} {item.Interview.Candidate.LastName}" : "Unknown")</span>
                        </td>
                        <td>
                            <div class="text-warning">
                                @for(int i=0; i < item.Rating; i++) { <i class="fas fa-star"></i> }
                                @for(int i=item.Rating; i < 5; i++) { <i class="far fa-star text-muted opacity-25"></i> }
                            </div>
                        </td>
                        <td>
                             <p class="mb-0 text-truncate" style="max-width: 350px;" title="@item.Comments">
                                @Html.DisplayFor(modelItem => item.Comments)
                            </p>
                        </td>
                        <td>
                            @item.CreatedDate.ToString("MMM dd, yyyy")
                        </td>
                        <td class="text-end pe-4">
                            <div class="btn-group">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary border-0 text-muted"><i class="fas fa-edit"></i></a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary border-0 text-muted"><i class="fas fa-eye"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger border-0"><i class="fas fa-trash"></i></a>
                            </div>
                        </td>
                    </tr>
            }
                </tbody>
            </table>
        </div>
    </div>
</div>
