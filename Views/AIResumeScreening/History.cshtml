@model RecruitmentPortal.Models.ViewModels.AIResumeScreeningHistoryViewModel

@{
    ViewData["Title"] = "AI Resume Screening History";
}

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">AI Resume Screening History</h1>
            <p class="text-muted mb-0">Browse and inspect historical AI resume evaluations and recommendation summaries.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-primary">
                <i class="fas fa-plus me-1"></i> New Resume Screening
            </a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card shadow-sm border mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="History" class="row g-2 align-items-center">
                <div class="col-md-4">
                    <select asp-for="SelectedJobPositionId" asp-items="Model.JobPositions" class="form-select" name="jobPositionId">
                    </select>
                </div>
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white text-muted"><i class="fas fa-search"></i></span>
                        <input type="text" class="form-control" name="searchTerm" value="@Model.SearchTerm" placeholder="Search by resume filename, recommendation, recruiter..." />
                    </div>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-3 flex-grow-1">
                        Filter
                    </button>
                    @if (Model.SelectedJobPositionId.HasValue || !string.IsNullOrWhiteSpace(Model.SearchTerm))
                    {
                        <a asp-action="History" class="btn btn-outline-secondary px-3" title="Clear Filters">
                            Reset
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- History Table Card -->
    <div class="card shadow-sm border">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0 fw-semibold text-dark">
                <i class="fas fa-list text-primary me-2"></i>Evaluated Resumes
            </h5>
            <span class="badge rounded-pill bg-light text-muted border">@Model.Screenings.Count Record(s)</span>
        </div>
        <div class="card-body p-0">
            @if (Model.Screenings.Count == 0)
            {
                <div class="text-center py-5 text-muted">
                    <i class="fas fa-folder-open fs-1 text-muted mb-3 d-block"></i>
                    <p class="mb-2 fw-semibold">No resume screening records found.</p>
                    <p class="small text-muted mb-3">Upload and screen a resume to generate comprehensive AI evaluation records.</p>
                    <a asp-action="Index" class="btn btn-outline-primary btn-sm">
                        <i class="fas fa-plus me-1"></i> Screen First Resume
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4 py-3 text-uppercase text-muted small fw-bold">Resume</th>
                                <th class="py-3 text-uppercase text-muted small fw-bold">Job Position</th>
                                <th class="py-3 text-uppercase text-muted small fw-bold text-center">Score</th>
                                <th class="py-3 text-uppercase text-muted small fw-bold">Recommendation</th>
                                <th class="py-3 text-uppercase text-muted small fw-bold">Screened By</th>
                                <th class="py-3 text-uppercase text-muted small fw-bold">Date</th>
                                <th class="pe-4 py-3 text-uppercase text-muted small fw-bold text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Screenings)
                            {
                                string scoreColorClass = item.OverallScore switch
                                {
                                    >= 80 => "bg-success-subtle text-success border-success-subtle",
                                    >= 65 => "bg-primary-subtle text-primary border-primary-subtle",
                                    >= 50 => "bg-warning-subtle text-warning border-warning-subtle",
                                    _ => "bg-danger-subtle text-danger border-danger-subtle"
                                };

                                string recBadgeClass = (item.Recommendation ?? string.Empty).ToLowerInvariant() switch
                                {
                                    var r when r.Contains("proceed") || r.Contains("hire") || r.Contains("advance") => "bg-success-subtle text-success border-success-subtle",
                                    var r when r.Contains("reservation") || r.Contains("consider") || r.Contains("hold") => "bg-warning-subtle text-warning border-warning-subtle",
                                    var r when r.Contains("not") || r.Contains("reject") => "bg-danger-subtle text-danger border-danger-subtle",
                                    _ => "bg-light text-secondary border"
                                };

                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <i class="fas fa-file-pdf text-danger fs-5 me-2"></i>
                                            <div>
                                                <div class="fw-semibold text-dark text-truncate" style="max-width: 200px;" title="@item.ResumeFileName">
                                                    @item.ResumeFileName
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(item.ResumeFilePath))
                                                {
                                                    <a href="@item.ResumeFilePath" target="_blank" download class="text-primary small text-decoration-none">
                                                        <i class="fas fa-download me-1"></i>Download
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="fw-medium text-dark">@item.JobPositionTitle</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge rounded-pill border px-3 py-1 fs-6 @scoreColorClass">
                                            @item.OverallScore <span class="small opacity-75">/100</span>
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge rounded-pill border px-2 py-1 @recBadgeClass">
                                            @item.Recommendation
                                        </span>
                                    </td>
                                    <td class="text-muted small">
                                        <i class="fas fa-user-circle me-1"></i>@item.ScreenedBy
                                    </td>
                                    <td class="text-muted small">
                                        @item.Date.ToLocalTime().ToString("MMM dd, yyyy HH:mm")
                                    </td>
                                    <td class="pe-4 text-end">
                                        <a asp-action="Result" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-eye me-1"></i> View
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
