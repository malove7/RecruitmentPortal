@model RecruitmentPortal.Models.ViewModels.AIResumeScreeningCreateViewModel

@{
    ViewData["Title"] = "AI Resume Screening";
}

<div class="container-fluid px-4 py-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">AI Resume Screening</h1>
            <p class="text-muted mb-0">Evaluate candidate resumes against position requirements with AI-powered skill extraction and analysis.</p>
        </div>
        <div>
            <a asp-action="History" class="btn btn-outline-secondary">
                <i class="fas fa-history me-1"></i> Screening History
            </a>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="fas fa-exclamation-triangle me-2 fs-5"></i>
                <div>
                    <strong>Screening Failed:</strong>
                    @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <!-- Main Form Column -->
        <div class="col-lg-7">
            <div class="card shadow-sm border mb-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="card-title mb-0 fw-semibold text-dark">
                        <i class="fas fa-file-invoice text-primary me-2"></i>Start Candidate Screening
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Screen" method="post" enctype="multipart/form-data" id="screeningForm">
                        @Html.AntiForgeryToken()

                        <!-- Job Position Select -->
                        <div class="mb-4">
                            <label asp-for="JobPositionId" class="form-label fw-semibold text-dark">
                                Target Job Position <span class="text-danger">*</span>
                            </label>
                            <select asp-for="JobPositionId" asp-items="Model.JobPositions" class="form-select form-select-lg" id="jobPositionSelect" required>
                                <option value="">-- Choose an Active Job Position --</option>
                            </select>
                            <span asp-validation-for="JobPositionId" class="text-danger small mt-1 d-block"></span>
                            <div class="form-text text-muted">
                                Job description, required skills, and requirements will be automatically retrieved from the position record.
                            </div>
                        </div>

                        <!-- Resume Upload -->
                        <div class="mb-4">
                            <label asp-for="ResumeFile" class="form-label fw-semibold text-dark">
                                Candidate Resume File <span class="text-danger">*</span>
                            </label>
                            
                            <div class="upload-dropzone p-4 text-center border border-2 border-dashed rounded-3 bg-light" id="dropZone">
                                <i class="fas fa-cloud-upload-alt text-primary fs-1 mb-2"></i>
                                <h6 class="fw-semibold text-dark mb-1">Click to browse or drag and drop resume here</h6>
                                <p class="text-muted small mb-2">Accepted formats: <strong>PDF (.pdf)</strong> or <strong>Word (.docx)</strong></p>
                                <p class="text-muted small mb-3">Maximum file size: 10 MB</p>

                                <input asp-for="ResumeFile" type="file" id="resumeFileInput" class="d-none" 
                                       accept=".pdf,.docx,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document" required />
                                
                                <button type="button" class="btn btn-sm btn-outline-primary px-3" onclick="document.getElementById('resumeFileInput').click()">
                                    <i class="fas fa-folder-open me-1"></i> Browse File
                                </button>
                                
                                <div id="selectedFileInfo" class="mt-3 d-none text-start p-2 rounded bg-white border">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div class="d-flex align-items-center">
                                            <i class="fas fa-file-alt text-primary fs-4 me-2" id="fileIcon"></i>
                                            <div>
                                                <div class="fw-semibold text-dark" id="fileNameDisplay">filename.pdf</div>
                                                <small class="text-muted" id="fileSizeDisplay">1.2 MB</small>
                                            </div>
                                        </div>
                                        <button type="button" class="btn btn-sm btn-link text-danger p-0 text-decoration-none" id="clearFileBtn" title="Remove file">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <span asp-validation-for="ResumeFile" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- AI Engine / Speed Selector -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold text-dark d-flex justify-content-between align-items-center mb-2">
                                <span>AI Screening Speed</span>
                                <span class="badge rounded-pill bg-success-subtle text-success border small" id="modelSpeedBadge">⚡ Fast (~3-5s)</span>
                            </label>
                            <div class="row g-2">
                                <div class="col-6">
                                    <div class="p-3 border rounded-3 bg-light h-100 position-relative model-option selected" id="optMiniContainer" style="cursor: pointer;">
                                        <div class="form-check m-0">
                                            <input class="form-check-input" type="radio" asp-for="SelectedModel" value="gpt-4o-mini" id="modelMini" checked>
                                            <label class="form-check-label ps-1 cursor-pointer w-100" for="modelMini">
                                                <strong class="d-block text-dark">⚡ Fast Screening</strong>
                                                <small class="text-muted d-block">gpt-4o-mini &bull; 3–5 seconds</small>
                                                <span class="badge rounded-pill bg-primary-subtle text-primary mt-1" style="font-size: 0.7rem;">Default & Recommended</span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="p-3 border rounded-3 bg-light h-100 position-relative model-option" id="opt4oContainer" style="cursor: pointer;">
                                        <div class="form-check m-0">
                                            <input class="form-check-input" type="radio" asp-for="SelectedModel" value="gpt-4o" id="model4o">
                                            <label class="form-check-label ps-1 cursor-pointer w-100" for="model4o">
                                                <strong class="d-block text-dark">🧠 Deep Analysis</strong>
                                                <small class="text-muted d-block">gpt-4o &bull; 10–20 seconds</small>
                                                <span class="badge rounded-pill bg-secondary-subtle text-secondary mt-1" style="font-size: 0.7rem;">Thorough Reasoning</span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Screening Progress Banner (Visible during analysis) -->
                        <div id="screeningProgress" class="alert alert-info border-info-subtle d-none mb-4" role="alert">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <div class="d-flex align-items-center">
                                    <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                                    <span class="fw-bold text-dark" id="progressTitle">Analyzing resume against job requirements...</span>
                                </div>
                                <span class="badge rounded-pill bg-primary text-white font-monospace" id="elapsedTimer">0.0s</span>
                            </div>
                            <div class="progress mb-2" style="height: 4px;">
                                <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" id="progressBar" style="width: 20%;"></div>
                            </div>
                            <small class="text-muted d-block" id="progressSubtitle">Extracting normalized text and evaluating candidate competencies. Please wait...</small>
                        </div>

                        <!-- Action Submit -->
                        <div class="d-flex justify-content-between align-items-center pt-2">
                            <a asp-controller="Home" asp-action="Dashboard" class="btn btn-outline-secondary">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-primary px-4 py-2" id="submitScreenBtn">
                                <i class="fas fa-wand-magic-sparkles me-2" id="btnIcon"></i>
                                <span id="btnText">Screen Resume</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Position Preview Column -->
        <div class="col-lg-5">
            <div class="card shadow-sm border mb-4">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0 fw-semibold text-dark">
                        <i class="fas fa-briefcase text-secondary me-2"></i>Position Criteria Preview
                    </h5>
                    <span id="previewBadge" class="badge rounded-pill bg-secondary-subtle text-secondary border">No Position Selected</span>
                </div>
                <div class="card-body p-4" id="positionPreviewBody">
                    <div id="noSelectionMessage" class="text-center py-5 text-muted">
                        <i class="fas fa-info-circle fs-2 text-muted mb-2 d-block"></i>
                        <p class="mb-0">Select a Target Job Position to view the job requirements and criteria that will be matched by the AI.</p>
                    </div>

                    <div id="positionDetailsContent" class="d-none">
                        <h5 class="fw-bold text-dark mb-3" id="previewTitle">Position Title</h5>
                        
                        <div class="mb-3">
                            <label class="text-uppercase small fw-bold text-muted d-block mb-1">Job Description</label>
                            <div class="p-3 bg-light rounded text-dark small" style="white-space: pre-wrap; max-height: 200px; overflow-y: auto;" id="previewDescription">
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="text-uppercase small fw-bold text-muted d-block mb-1">Requirements & Skills</label>
                            <div class="p-3 bg-light rounded text-dark small" style="white-space: pre-wrap; max-height: 200px; overflow-y: auto;" id="previewRequirements">
                            </div>
                        </div>

                        <div class="alert alert-light border small text-muted mb-0">
                            <i class="fas fa-shield-alt text-primary me-1"></i>
                            Strict AI rules are enforced: only verifiable facts from the resume will be scored.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('screeningForm');
            const submitBtn = document.getElementById('submitScreenBtn');
            const btnText = document.getElementById('btnText');
            const btnIcon = document.getElementById('btnIcon');
            const progressBanner = document.getElementById('screeningProgress');
            const fileInput = document.getElementById('resumeFileInput');
            const dropZone = document.getElementById('dropZone');
            const fileInfo = document.getElementById('selectedFileInfo');
            const fileNameDisplay = document.getElementById('fileNameDisplay');
            const fileSizeDisplay = document.getElementById('fileSizeDisplay');
            const fileIcon = document.getElementById('fileIcon');
            const clearFileBtn = document.getElementById('clearFileBtn');
            const jobSelect = document.getElementById('jobPositionSelect');

            // Position preview elements
            const noSelectionMessage = document.getElementById('noSelectionMessage');
            const positionDetailsContent = document.getElementById('positionDetailsContent');
            const previewBadge = document.getElementById('previewBadge');
            const previewTitle = document.getElementById('previewTitle');
            const previewDescription = document.getElementById('previewDescription');
            const previewRequirements = document.getElementById('previewRequirements');

            // File selection display
            fileInput.addEventListener('change', function () {
                handleFileSelection(this.files[0]);
            });

            // Drag and drop support
            ['dragenter', 'dragover'].forEach(eventName => {
                dropZone.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    dropZone.classList.add('bg-white', 'border-primary');
                }, false);
            });

            ['dragleave', 'drop'].forEach(eventName => {
                dropZone.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    dropZone.classList.remove('bg-white', 'border-primary');
                }, false);
            });

            dropZone.addEventListener('drop', (e) => {
                const dt = e.dataTransfer;
                const files = dt.files;
                if (files.length > 0) {
                    fileInput.files = files;
                    handleFileSelection(files[0]);
                }
            });

            function handleFileSelection(file) {
                if (!file) {
                    fileInfo.classList.add('d-none');
                    return;
                }

                fileNameDisplay.textContent = file.name;
                fileSizeDisplay.textContent = (file.size / (1024 * 1024)).toFixed(2) + ' MB';

                const ext = file.name.split('.').pop().toLowerCase();
                if (ext === 'pdf') {
                    fileIcon.className = 'fas fa-file-pdf text-danger fs-4 me-2';
                } else if (ext === 'docx') {
                    fileIcon.className = 'fas fa-file-word text-primary fs-4 me-2';
                } else {
                    fileIcon.className = 'fas fa-file-alt text-secondary fs-4 me-2';
                }

                fileInfo.classList.remove('d-none');
            }

            clearFileBtn.addEventListener('click', function (e) {
                e.stopPropagation();
                fileInput.value = '';
                fileInfo.classList.add('d-none');
            });

            // Job position change -> AJAX fetch preview details
            jobSelect.addEventListener('change', function () {
                const positionId = this.value;
                if (!positionId) {
                    noSelectionMessage.classList.remove('d-none');
                    positionDetailsContent.classList.add('d-none');
                    previewBadge.textContent = 'No Position Selected';
                    previewBadge.className = 'badge rounded-pill bg-secondary-subtle text-secondary border';
                    return;
                }

                previewBadge.textContent = 'Loading...';
                previewBadge.className = 'badge rounded-pill bg-info-subtle text-info border';

                fetch('@Url.Action("GetJobPositionDetails", "AIResumeScreening")/' + positionId)
                    .then(response => response.json())
                    .then(data => {
                        if (data && data.success) {
                            previewTitle.textContent = data.title;
                            previewDescription.textContent = data.description || 'No description provided.';
                            previewRequirements.textContent = data.requirements || 'No specific requirements listed.';

                            noSelectionMessage.classList.add('d-none');
                            positionDetailsContent.classList.remove('d-none');
                            previewBadge.textContent = 'Active Position Criteria';
                            previewBadge.className = 'badge rounded-pill bg-success-subtle text-success border';
                        } else {
                            noSelectionMessage.classList.remove('d-none');
                            positionDetailsContent.classList.add('d-none');
                            previewBadge.textContent = 'Error Loading Criteria';
                        }
                    })
                    .catch(() => {
                        previewBadge.textContent = 'Error Loading Criteria';
                    });
            });

            // Trigger preview if position is pre-selected
            if (jobSelect.value) {
                jobSelect.dispatchEvent(new Event('change'));
            }

            // Model selection cards interactivity
            const optMini = document.getElementById('modelMini');
            const opt4o = document.getElementById('model4o');
            const optMiniContainer = document.getElementById('optMiniContainer');
            const opt4oContainer = document.getElementById('opt4oContainer');
            const modelSpeedBadge = document.getElementById('modelSpeedBadge');

            function updateModelUI() {
                if (optMini.checked) {
                    optMiniContainer.classList.add('border-primary', 'bg-white');
                    optMiniContainer.classList.remove('bg-light');
                    opt4oContainer.classList.remove('border-primary', 'bg-white');
                    opt4oContainer.classList.add('bg-light');
                    modelSpeedBadge.textContent = '⚡ Fast (~3-5s)';
                    modelSpeedBadge.className = 'badge rounded-pill bg-success-subtle text-success border small';
                } else {
                    opt4oContainer.classList.add('border-primary', 'bg-white');
                    opt4oContainer.classList.remove('bg-light');
                    optMiniContainer.classList.remove('border-primary', 'bg-white');
                    optMiniContainer.classList.add('bg-light');
                    modelSpeedBadge.textContent = '🧠 Deep (~10-20s)';
                    modelSpeedBadge.className = 'badge rounded-pill bg-primary-subtle text-primary border small';
                }
            }

            optMiniContainer.addEventListener('click', () => { optMini.checked = true; updateModelUI(); });
            opt4oContainer.addEventListener('click', () => { opt4o.checked = true; updateModelUI(); });
            optMini.addEventListener('change', updateModelUI);
            opt4o.addEventListener('change', updateModelUI);
            updateModelUI();

            // Form submission -> disable button, show analyzing state with live timer
            form.addEventListener('submit', function (e) {
                if (!form.checkValidity()) {
                    return; // Let browser validation trigger
                }

                // Check file selected
                if (!fileInput.files || fileInput.files.length === 0) {
                    alert('Please select a resume file before screening.');
                    e.preventDefault();
                    return;
                }

                // Section 10 requirement:
                // While screening show: "Analyzing resume against job requirements..."
                // Disable the submit button until completed.
                submitBtn.disabled = true;
                btnIcon.className = 'spinner-border spinner-border-sm me-2';
                btnText.textContent = 'Analyzing resume against job requirements...';
                progressBanner.classList.remove('d-none');

                // Live timer & progress stages
                const startTime = Date.now();
                const timerEl = document.getElementById('elapsedTimer');
                const progressBar = document.getElementById('progressBar');
                const progressSubtitle = document.getElementById('progressSubtitle');

                const timerInterval = setInterval(() => {
                    const elapsed = (Date.now() - startTime) / 1000;
                    timerEl.textContent = elapsed.toFixed(1) + 's';

                    if (elapsed < 1.5) {
                        progressBar.style.width = '30%';
                        progressSubtitle.textContent = 'Extracting normalized text and validating resume format...';
                    } else if (elapsed < 3.5) {
                        progressBar.style.width = '65%';
                        progressSubtitle.textContent = 'Evaluating candidate competencies and matching skills against job position...';
                    } else {
                        progressBar.style.width = '90%';
                        progressSubtitle.textContent = 'Synthesizing evidence, requirement gaps, and targeted interview questions...';
                    }
                }, 100);
            });
        });
    </script>
}
