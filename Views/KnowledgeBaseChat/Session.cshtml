@model RecruitmentPortal.Models.ViewModels.KnowledgeBaseChatViewModel

@{
    ViewData["Title"] = $"{Model.KnowledgeBaseName} - Chat";
}

<div class="container-fluid px-4 py-3 h-100 d-flex flex-column" style="max-height: calc(100vh - 80px);">
    <!-- Chat Header -->
    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom flex-wrap gap-2">
        <div class="d-flex align-items-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2">
                    <h1 class="h4 fw-bold text-dark mb-0">@Model.KnowledgeBaseName</h1>
                    <span class="badge badge-success"><i class="fas fa-brain me-1"></i>RAG Chatbot</span>
                </div>
                <div class="text-muted small">Answers grounded strictly in knowledge base excerpts with source citations.</div>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2">
            <!-- Switch KB Dropdown -->
            @if (Model.AvailableKnowledgeBases.Count > 1)
            {
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fas fa-database me-1"></i> Switch Knowledge Base
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                        @foreach (var kb in Model.AvailableKnowledgeBases)
                        {
                            <li>
                                <a class="dropdown-item @(kb.Id == Model.KnowledgeBaseId ? "active" : "")"
                                   asp-action="Session" asp-route-knowledgeBaseId="@kb.Id">
                                    @kb.Name
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }

            <form asp-action="NewSession" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="knowledgeBaseId" value="@Model.KnowledgeBaseId" />
                <button type="submit" class="btn btn-sm btn-primary">
                    <i class="fas fa-plus me-1"></i> New Chat
                </button>
            </form>

            @if (User.HasClaim("Permission", "ViewKnowledgeBases") || User.IsInRole("Admin"))
            {
                <a asp-controller="KnowledgeBases" asp-action="Documents" asp-route-id="@Model.KnowledgeBaseId" class="btn btn-sm btn-outline-secondary" title="View Source Documents">
                    <i class="fas fa-file-alt me-1"></i> Documents
                </a>
            }
        </div>
    </div>

    <!-- Main Chat Workspace -->
    <div class="row g-3 flex-grow-1 overflow-hidden" style="min-height: 0;">
        <!-- Left Sidebar: Session History -->
        <div class="col-lg-3 col-xl-3 d-none d-lg-block h-100">
            <div class="card shadow-sm border h-100 d-flex flex-column">
                <div class="card-header bg-white py-2 px-3 border-bottom d-flex justify-content-between align-items-center">
                    <span class="small fw-bold text-uppercase text-muted">Recent Chats</span>
                    <span class="badge badge-secondary">@Model.Sessions.Count</span>
                </div>
                <div class="card-body p-2 overflow-y-auto flex-grow-1" style="min-height: 0;">
                    @if (Model.Sessions.Count == 0)
                    {
                        <div class="text-center py-4 text-muted small">
                            No chat history yet.
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var s in Model.Sessions)
                            {
                                var isActive = Model.CurrentSessionId == s.Id;
                                <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2 px-2 rounded mb-1 border-0 @(isActive ? "bg-light fw-bold" : "")">
                                    <a asp-action="Session" asp-route-id="@s.Id" asp-route-knowledgeBaseId="@Model.KnowledgeBaseId"
                                       class="text-decoration-none text-dark flex-grow-1 text-truncate me-2 small">
                                        <i class="far fa-comment me-1 text-primary"></i> @s.Title
                                    </a>
                                    <form asp-action="DeleteSession" asp-route-id="@s.Id" asp-route-knowledgeBaseId="@Model.KnowledgeBaseId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-link text-muted p-0 border-0 opacity-50 hover-opacity-100" title="Delete Chat" onclick="return confirm('Delete this conversation?');">
                                            <i class="fas fa-times fa-xs"></i>
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Chat Area -->
        <div class="col-lg-9 col-xl-9 h-100 d-flex flex-column">
            <div class="card shadow-sm border h-100 d-flex flex-column">
                <!-- Message Thread Container -->
                <div class="card-body p-4 overflow-y-auto flex-grow-1" id="chatThread" style="min-height: 0; background-color: var(--bg-body);">
                    @if (Model.Messages.Count == 0)
                    {
                        <div class="h-100 d-flex flex-column justify-content-center align-items-center text-center py-5" id="emptyChatPlaceholder">
                            <div class="rounded-circle p-3 mb-3" style="background-color: rgba(99, 102, 241, 0.1); color: var(--primary-color);">
                                <i class="fas fa-robot fa-3x"></i>
                            </div>
                            <h5 class="fw-bold text-dark mb-1">Knowledge-Base Assistant</h5>
                            <p class="text-muted small mb-4" style="max-width: 480px;">
                                Ask any question about <strong>@Model.KnowledgeBaseName</strong>. Answers are retrieved via Pinecone vector similarity and synthesized strictly from your uploaded documents.
                            </p>
                            <div class="d-flex flex-wrap gap-2 justify-content-center" style="max-width: 600px;">
                                <button type="button" class="btn btn-sm btn-outline-secondary quick-question-btn" data-question="What are the key policies covered in this knowledge base?">
                                    "What policies are covered in this knowledge base?"
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary quick-question-btn" data-question="What are the candidate evaluation criteria?">
                                    "What are the candidate evaluation criteria?"
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary quick-question-btn" data-question="Can you summarize the main guidelines?">
                                    "Can you summarize the main guidelines?"
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        @foreach (var msg in Model.Messages)
                        {
                            if (msg.Role == "user")
                            {
                                <!-- User Message -->
                                <div class="d-flex justify-content-end mb-3">
                                    <div class="p-3 rounded shadow-sm text-white" style="max-width: 75%; background: linear-gradient(135deg, #7c3aed, #6366f1); border-radius: 12px 12px 2px 12px !important;">
                                        <div class="small fw-semibold mb-1 opacity-75">You</div>
                                        <div class="user-message-text" style="white-space: pre-wrap;">@msg.Content</div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <!-- Assistant Message -->
                                <div class="d-flex justify-content-start mb-4">
                                    <div class="card shadow-sm border p-3 bg-white" style="max-width: 85%; border-radius: 12px 12px 12px 2px !important;">
                                        <div class="d-flex align-items-center gap-2 mb-2">
                                            <i class="fas fa-robot text-primary"></i>
                                            <span class="small fw-bold text-dark">Assistant</span>
                                            <span class="badge badge-secondary ms-auto">Grounded RAG</span>
                                        </div>
                                        <div class="assistant-message-text text-dark" style="white-space: pre-wrap; line-height: 1.6;">@msg.Content</div>

                                        @if (msg.Citations != null && msg.Citations.Count > 0)
                                        {
                                            <div class="mt-3 pt-2 border-top">
                                                <div class="d-flex align-items-center justify-content-between mb-2">
                                                    <span class="small fw-bold text-muted text-uppercase">
                                                        <i class="fas fa-quote-left text-primary me-1"></i> Citations (@msg.Citations.Count)
                                                    </span>
                                                </div>
                                                <div class="d-flex flex-wrap gap-1">
                                                    @foreach (var cite in msg.Citations)
                                                    {
                                                        var pageInfo = cite.PageNumber.HasValue ? $"p. {cite.PageNumber}" : $"chunk {cite.ChunkIndex}";
                                                        <span class="badge badge-info" title="Score: @cite.Score.ToString("F3")">
                                                            <i class="fas fa-file-alt me-1"></i> @cite.FileName (@pageInfo)
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    }
                </div>

                <!-- Input Footer -->
                <div class="card-footer bg-white p-3 border-top">
                    <form id="chatForm">
                        @Html.AntiForgeryToken()
                        <div class="input-group">
                            <textarea id="questionInput" class="form-control" rows="2" placeholder="Ask a question about @Model.KnowledgeBaseName... (Press Enter to send, Shift+Enter for new line)" style="resize: none;"></textarea>
                            <button type="submit" class="btn btn-primary px-4" id="sendBtn">
                                <i class="fas fa-paper-plane me-1"></i> Send
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            var kbId = @Model.KnowledgeBaseId;
            var currentSessionId = @(Model.CurrentSessionId.HasValue ? Model.CurrentSessionId.Value : "null");
            var chatThread = $('#chatThread');
            var questionInput = $('#questionInput');
            var sendBtn = $('#sendBtn');
            var chatForm = $('#chatForm');
            var placeholder = $('#emptyChatPlaceholder');

            // Scroll to bottom
            function scrollToBottom() {
                chatThread.scrollTop(chatThread[0].scrollHeight);
            }
            scrollToBottom();

            // Quick question clicks
            $('.quick-question-btn').on('click', function () {
                var q = $(this).data('question');
                questionInput.val(q);
                chatForm.submit();
            });

            // Enter key handling
            questionInput.on('keydown', function (e) {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    chatForm.submit();
                }
            });

            chatForm.on('submit', function (e) {
                e.preventDefault();
                var question = questionInput.val().trim();
                if (!question) return;

                if (placeholder.length) {
                    placeholder.remove();
                }

                // Append user message to UI
                var userBubbleHtml =
                    '<div class="d-flex justify-content-end mb-3">' +
                    '  <div class="p-3 rounded shadow-sm text-white" style="max-width: 75%; background: linear-gradient(135deg, #7c3aed, #6366f1); border-radius: 12px 12px 2px 12px !important;">' +
                    '    <div class="small fw-semibold mb-1 opacity-75">You</div>' +
                    '    <div class="user-message-text" style="white-space: pre-wrap;">' + $('<div>').text(question).html() + '</div>' +
                    '  </div>' +
                    '</div>';
                chatThread.append(userBubbleHtml);

                // Append typing indicator
                var typingId = 'typing-' + Date.now();
                var typingHtml =
                    '<div class="d-flex justify-content-start mb-4" id="' + typingId + '">' +
                    '  <div class="card shadow-sm border p-3 bg-white" style="max-width: 85%; border-radius: 12px 12px 12px 2px !important;">' +
                    '    <div class="d-flex align-items-center gap-2">' +
                    '      <i class="fas fa-robot text-primary"></i>' +
                    '      <span class="small fw-bold text-dark">Assistant</span>' +
                    '      <span class="spinner-border spinner-border-sm text-primary ms-2" role="status"></span>' +
                    '      <span class="text-muted small">Retrieving excerpts & generating answer...</span>' +
                    '    </div>' +
                    '  </div>' +
                    '</div>';
                chatThread.append(typingHtml);
                scrollToBottom();

                questionInput.val('');
                questionInput.prop('disabled', true);
                sendBtn.prop('disabled', true);

                var token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '/KnowledgeBaseChat/SendMessage',
                    type: 'POST',
                    contentType: 'application/json',
                    headers: {
                        'RequestVerificationToken': token
                    },
                    data: JSON.stringify({
                        knowledgeBaseId: kbId,
                        sessionId: currentSessionId,
                        question: question
                    }),
                    success: function (res) {
                        $('#' + typingId).remove();

                        if (res.sessionId && !currentSessionId) {
                            currentSessionId = res.sessionId;
                            // Optionally update browser URL without reload
                            if (window.history && window.history.replaceState) {
                                window.history.replaceState(null, '', '/KnowledgeBaseChat/Session?id=' + res.sessionId + '&knowledgeBaseId=' + kbId);
                            }
                        }

                        var citationsHtml = '';
                        if (res.citations && res.citations.length > 0) {
                            citationsHtml +=
                                '<div class="mt-3 pt-2 border-top">' +
                                '  <div class="d-flex align-items-center justify-content-between mb-2">' +
                                '    <span class="small fw-bold text-muted text-uppercase">' +
                                '      <i class="fas fa-quote-left text-primary me-1"></i> Citations (' + res.citations.length + ')' +
                                '    </span>' +
                                '  </div>' +
                                '  <div class="d-flex flex-wrap gap-1">';

                            for (var i = 0; i < res.citations.length; i++) {
                                var c = res.citations[i];
                                var pageRef = c.pageNumber ? ('p. ' + c.pageNumber) : ('chunk ' + c.chunkIndex);
                                citationsHtml +=
                                    '<span class="badge badge-info" title="Score: ' + (c.score ? c.score.toFixed(3) : 'N/A') + '">' +
                                    '  <i class="fas fa-file-alt me-1"></i> ' + $('<div>').text(c.fileName).html() + ' (' + pageRef + ')' +
                                    '</span>';
                            }

                            citationsHtml += '</div></div>';
                        }

                        var answerText = res.answer || "I could not find this in the selected knowledge base.";
                        var answerBubbleHtml =
                            '<div class="d-flex justify-content-start mb-4">' +
                            '  <div class="card shadow-sm border p-3 bg-white" style="max-width: 85%; border-radius: 12px 12px 12px 2px !important;">' +
                            '    <div class="d-flex align-items-center gap-2 mb-2">' +
                            '      <i class="fas fa-robot text-primary"></i>' +
                            '      <span class="small fw-bold text-dark">Assistant</span>' +
                            '      <span class="badge badge-secondary ms-auto">Grounded RAG</span>' +
                            '    </div>' +
                            '    <div class="assistant-message-text text-dark" style="white-space: pre-wrap; line-height: 1.6;">' + $('<div>').text(answerText).html() + '</div>' +
                            citationsHtml +
                            '  </div>' +
                            '</div>';

                        chatThread.append(answerBubbleHtml);
                        scrollToBottom();
                    },
                    error: function (xhr, status, error) {
                        $('#' + typingId).remove();

                        var errBubbleHtml =
                            '<div class="d-flex justify-content-start mb-4">' +
                            '  <div class="card shadow-sm border border-danger p-3 bg-white" style="max-width: 85%;">' +
                            '    <div class="d-flex align-items-center gap-2 mb-1 text-danger">' +
                            '      <i class="fas fa-exclamation-triangle"></i>' +
                            '      <span class="small fw-bold">Error</span>' +
                            '    </div>' +
                            '    <div class="text-danger small">Failed to process request: ' + $('<div>').text(error || 'Server error').html() + '</div>' +
                            '  </div>' +
                            '</div>';
                        chatThread.append(errBubbleHtml);
                        scrollToBottom();
                    },
                    complete: function () {
                        questionInput.prop('disabled', false);
                        sendBtn.prop('disabled', false);
                        questionInput.focus();
                    }
                });
            });
        });
    </script>
}
